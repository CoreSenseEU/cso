            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>occurrence def</sysmlKind>
        <sysmlName>CSBase::BinaryRelationState</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">binary relation state</rdfs:label>
        <skos:altLabel xml:lang="en">BinaryRelationState</skos:altLabel>
        <skos:definition xml:lang="en">The state of a BinaryRelation at a given time instant is the tuple of the values of its attributes.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Capability -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Capability">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#realizes"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#system"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#acceptanceCriteria"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#conditions"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Capability</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">capability</rdfs:label>
        <skos:altLabel xml:lang="en">Capability</skos:altLabel>
        <skos:definition xml:lang="en">A capability is the ability of a system to perform a specific function successfully under stated conditions and acceptance criteria.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#CognitiveCapability -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#CognitiveCapability">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Capability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#modelets"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#realizes"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#CognitiveFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::CognitiveCapability</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">cognitive capability</rdfs:label>
        <skos:altLabel xml:lang="en">CognitiveCapability</skos:altLabel>
        <skos:definition xml:lang="en">A cognitive capability is a capability of a system that is realized by a cognitive function and enables the system to use knowledge to produce intentional action.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#CognitiveFunction -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#CognitiveFunction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Function"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#modelets"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::CognitiveFunction</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">cognitive function</rdfs:label>
        <skos:altLabel xml:lang="en">CognitiveFunction</skos:altLabel>
        <skos:definition xml:lang="en">A cognitive function is a function that processes information by executing one or more modelets.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Concern -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Concern">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#sh"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Stakeholder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#description"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Concern</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">concern</rdfs:label>
        <skos:altLabel xml:lang="en">Concern</skos:altLabel>
        <skos:definition xml:lang="en">A concern is a matter of interest to a stakeholder that, in a given context, can be derived from a need and may give rise to requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Context -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Context">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#conditions"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#knowledge"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Context</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">context</rdfs:label>
        <skos:altLabel xml:lang="en">Context</skos:altLabel>
        <skos:definition xml:lang="en">Given an extended system, the context is the set of the content retained about that extended system, together with the assumptions and conditions, deemed relevant to interpret, evaluate and act within that extended system.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ContributesToBehavior -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ContributesToBehavior">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#behavior"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>

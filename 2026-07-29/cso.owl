                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ModeletAspect_parameter"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ModeletAspect_performance"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ModeletAspect_property"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ModeletAspect_states"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ModeletAspect_structure"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <sysmlKind>enum def</sysmlKind>
        <sysmlName>CSCore::ModeletAspect</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">modelet aspect</rdfs:label>
        <skos:altLabel xml:lang="en">ModeletAspect</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ModeletEnginePair -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ModeletEnginePair">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#engine"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Engine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#modelet"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::ModeletEnginePair</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint EngineSupportsModelet: engine.modelets-&gt;SequenceFunctions::includes(modelet)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">modelet engine pair</rdfs:label>
        <skos:altLabel xml:lang="en">ModeletEnginePair</skos:altLabel>
        <skos:definition xml:lang="en">Pairing of a modelet with an engine that can exert it.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#OMG_MOF -->



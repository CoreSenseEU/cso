        <sysmlName>CSCore::Modelet</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">modelet</rdfs:label>
        <skos:altLabel xml:lang="en">Modelet</skos:altLabel>
        <skos:definition xml:lang="en">A modelet is a model fragment that represents a specific aspect of a referent system or entity.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ModeletAspect -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ModeletAspect">

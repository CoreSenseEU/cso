        <terms:publisher xml:lang="en">The CORESENSE Consortium</terms:publisher>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <terms:title xml:lang="en">CoreSense Ontology (CSO)</terms:title>
        <rdfs:seeAlso rdf:resource="http://www.coresense.eu"/>
        <owl:versionInfo>2026-07-29</owl:versionInfo>
    </owl:Ontology>
    



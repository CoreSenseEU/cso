    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#PerformanceConstraint -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#PerformanceConstraint">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#actualResponseTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#maxResponseTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>constraint def</sysmlKind>
        <sysmlName>CSCore::PerformanceConstraint</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint ResponseTime: actualResponseTime &lt;= maxResponseTime</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">performance constraint</rdfs:label>
        <skos:altLabel xml:lang="en">PerformanceConstraint</skos:altLabel>
        <skos:definition xml:lang="en">Performance constraint on model usage (e.g., for run-time use).</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#PerformanceMeasure -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#PerformanceMeasure">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#goals"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#exhibitedBehavior"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExhibitedBehavior"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#object"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#perfType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#PerformanceMeasureType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#value"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::PerformanceMeasure</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint BehaviorOfTargetSystem: exhibitedBehavior.system == context.extendedSystem.targetSystem</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint GoalsOfSameExtendedSystem: goals-&gt;ControlFunctions::forAll { in g : Goal; g.extendedSystem == context.extendedSystem }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint ObjectWithinExtendedSystem: object == extendedSystem.targetSystem or extendedSystem.targetSystem.components-&gt;SequenceFunctions::includes(object) or extendedSystem.environmentEntities-&gt;SequenceFunctions::includes(object)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">performance measure</rdfs:label>
        <skos:altLabel xml:lang="en">PerformanceMeasure</skos:altLabel>
        <skos:definition xml:lang="en">Performance is a measure of how effectively the exhibited behavior of a system (or one of its components) contributes to fulfilling its goals when executing tasks within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#PerformanceMeasureType -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#PerformanceMeasureType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#PerformanceMeasureType_MOE"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#PerformanceMeasureType_MOP"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#PerformanceMeasureType_TPM"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <sysmlKind>enum def</sysmlKind>
        <sysmlName>CSBase::PerformanceMeasureType</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">performance measure type</rdfs:label>
        <skos:altLabel xml:lang="en">PerformanceMeasureType</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Phenomenon -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Phenomenon">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#exhibitedBy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#description"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::Phenomenon</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint ContextMatchesExtendedSystem: context.extendedSystem == extendedSystem</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint ExhibitedByWithinExtendedSystem: exhibitedBy-&gt;ControlFunctions::forAll { in b : Entity; b == extendedSystem or b == extendedSystem.targetSystem or extendedSystem.targetSystem.components-&gt;SequenceFunctions::includes(b) or extendedSystem.environmentEntities-&gt;SequenceFunctions::includes(b) }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">phenomenon</rdfs:label>
        <skos:altLabel xml:lang="en">Phenomenon</skos:altLabel>
        <skos:definition xml:lang="en">A phenomenon is any distinguishable aspect or behavior of an extended system, or of one of its parts, within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Policy -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Policy">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#candidateActions"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSActionControl::Policy</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">policy</rdfs:label>
        <skos:altLabel xml:lang="en">Policy</skos:altLabel>
        <skos:definition xml:lang="en">A policy is a rule or strategy that, for a given action trigger and a given context of an extended system, determines a set of candidate actions that are admissible responses to that trigger in that context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#PotentialBehavior -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#PotentialBehavior">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#trajectories"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#SystemTrajectory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#system"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#timeInterval"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#TimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::PotentialBehavior</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint ConsistentWithSystem: trajectories-&gt;ControlFunctions::forAll { in tr : SystemTrajectory; tr.system == system }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint TrajectoriesAtSameInterval: trajectories-&gt;ControlFunctions::forAll { in tr : SystemTrajectory; tr.timeInterval.initialTime == timeInterval.initialTime and tr.timeInterval.finalTime == timeInterval.finalTime }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">potential behavior</rdfs:label>
        <skos:altLabel xml:lang="en">PotentialBehavior</skos:altLabel>
        <skos:definition xml:lang="en">The potential behavior of a system over a time interval is the set of all trajectories the system may follow over that interval.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Projection -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Projection">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#potentialBehavior"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#PotentialBehavior"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#timeInterval"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#TimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::Projection</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint PotentialBehaviorIsOfThisExtendedSystem: potentialBehavior.system == extendedSystem</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">projection</rdfs:label>
        <skos:altLabel xml:lang="en">Projection</skos:altLabel>
        <skos:definition xml:lang="en">Projection is a representation that maps a given situation of an extended system in a given context, into a representation in a chosen space, over a specified projection domain.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Provenance -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Provenance">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Provenance_Derived"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Provenance_Historical"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Provenance_Original"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Provenance_Versioned"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <sysmlKind>enum def</sysmlKind>
        <sysmlName>CSCore::Provenance</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">provenance</rdfs:label>
        <skos:altLabel xml:lang="en">Provenance</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Risk -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Risk">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#adverseEvent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#AdverseOccurrence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#likelihood"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#severity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Risk</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint LikelihoodBounds: 0.0 &lt;= likelihood and likelihood &lt;= 1.0</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">risk</rdfs:label>
        <skos:altLabel xml:lang="en">Risk</skos:altLabel>
        <skos:definition xml:lang="en">A risk is a measure of the potential for an adverse event to negatively affect an entity, system, or extended system within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Role -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Role">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#playedBy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#timeInterval"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#TimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#responsibilities"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#roleConstraints"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Role</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:altLabel xml:lang="en">Role</skos:altLabel>
        <skos:definition xml:lang="en">A role is a context- and time-dependent designation, with associated responsibilities and constraints, that an entity may assume in order to contribute to the achievement or maintenance of a goal.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ScalabilityConstraint -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ScalabilityConstraint">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#maxUsers"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#numberOfUsers"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>constraint def</sysmlKind>
        <sysmlName>CSCore::ScalabilityConstraint</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint Scalability: numberOfUsers &lt;= maxUsers</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">scalability constraint</rdfs:label>
        <skos:altLabel xml:lang="en">ScalabilityConstraint</skos:altLabel>
        <skos:definition xml:lang="en">Scalability constraint on model usage (e.g., number of concurrent users).</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SelfModel -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SelfModel">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Model"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#referent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#usedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>abstract part def</sysmlKind>
        <sysmlName>CSCore::SelfModel</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint SelfEquality: referent == usedBy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">self model</rdfs:label>
        <skos:altLabel xml:lang="en">SelfModel</skos:altLabel>
        <skos:definition xml:lang="en">A SelfModel is a Model whose referent is the owning system itself.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Sense -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Sense">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#rawData"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Data"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#target"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>action def</sysmlKind>
        <sysmlName>CSBase::Sense</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint OutputConsistent: rawData.extendedSystem == extendedSystem</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint TargetWithinExtendedSystem: target == extendedSystem.targetSystem or extendedSystem.targetSystem.components-&gt;SequenceFunctions::includes(target) or extendedSystem.environmentEntities-&gt;SequenceFunctions::includes(target)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">sense</rdfs:label>
        <skos:altLabel xml:lang="en">Sense</skos:altLabel>
        <skos:definition xml:lang="en">Acquire raw sensor data about the phenomenon being observed in the extended system.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Sensor -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Sensor">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#observes"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#senses"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Sense"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>part def</sysmlKind>
        <sysmlName>CSBase::Sensor</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint SenseTargetsObservableEntities: senses-&gt;ControlFunctions::forAll { in s : Sense; observes-&gt;SequenceFunctions::includes(s.target) }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">sensor</rdfs:label>
        <skos:altLabel xml:lang="en">Sensor</skos:altLabel>
        <skos:definition xml:lang="en">A sensor is an entity that acquires raw data about phenomena, properties, states, or attributes of another entity being observed in the extended system.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Situation -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Situation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#holdsOver"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#SystemState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#situationContext"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#conditions"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>constraint def</sysmlKind>
        <sysmlName>CSBase::Situation</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">situation</rdfs:label>
        <skos:altLabel xml:lang="en">Situation</skos:altLabel>
        <skos:definition xml:lang="en">A situation is a context-dependent condition on the state or exhibited behavior of an extended system, expressed in terms of a finite subset of relevant attribute values and relation instances.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Stakeholder -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Stakeholder">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#desires"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Desire"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#interests"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Interest"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Stakeholder</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint OwnsDesires: desires-&gt;ControlFunctions::forAll { in d : Desire; d.who == self }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint OwnsInterests: interests-&gt;ControlFunctions::forAll { in c : Interest; c.who == self }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">stakeholder</rdfs:label>
        <skos:altLabel xml:lang="en">Stakeholder</skos:altLabel>
        <skos:definition xml:lang="en">A stakeholder is an entity for whom a system S is relevant because the behavior or outcomes of S can affect the achievement of its own goals.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#StakeholderValue -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#StakeholderValue">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#sh"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Stakeholder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#benefit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#cost"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::StakeholderValue</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">stakeholder value</rdfs:label>
        <skos:altLabel xml:lang="en">StakeholderValue</skos:altLabel>
        <skos:definition xml:lang="en">Stakeholder value is the amount of benefit at a cost provided to stakeholders within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SuperSystem -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SuperSystem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#System"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#components"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>part def</sysmlKind>
        <sysmlName>CSBase::SuperSystem</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">super system</rdfs:label>
        <skos:altLabel xml:lang="en">SuperSystem</skos:altLabel>
        <skos:definition xml:lang="en">A super system is a system whose components are, themselves, systems.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#System -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#System">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#components"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#relations"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#BinaryRelation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#isAdaptable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>part def</sysmlKind>
        <sysmlName>CSBase::System</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">system</rdfs:label>
        <skos:altLabel xml:lang="en">System</skos:altLabel>
        <skos:definition xml:lang="en">A system is an entity represented by a tuple (C, R), where C is a set of components and R is the set of binary relations between them.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SystemOfInterest -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SystemOfInterest">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#csstakeholder"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Stakeholder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#system"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::SystemOfInterest</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">system of interest</rdfs:label>
        <skos:altLabel xml:lang="en">SystemOfInterest</skos:altLabel>
        <skos:definition xml:lang="en">For a given stakeholder, the system of interest is the part of an extended system that constitutes the focus of engineering activities.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SystemState -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SystemState">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#EntityState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#componentStates"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#EntityState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#relationStates"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#BinaryRelationState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#entity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>occurrence def</sysmlKind>
        <sysmlName>CSBase::SystemState</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint AllComponentsHaveState: entity.components-&gt;ControlFunctions::forAll { in c : Entity; componentStates-&gt;ControlFunctions::exists { in es : EntityState; es.entity == c } }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint AllRelationsHaveState: entity.relations-&gt;ControlFunctions::forAll { in r : BinaryRelation; relationStates-&gt;ControlFunctions::exists { in rs : BinaryRelationState; rs.relation == r } }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint AtMostOneStatePerComponent: componentStates-&gt;ControlFunctions::forAll { in es1 : EntityState; componentStates-&gt;ControlFunctions::forAll { in es2 : EntityState; es1 != es2 implies es1.entity != es2.entity } }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint AtMostOneStatePerRelation: relationStates-&gt;ControlFunctions::forAll { in rs1 : BinaryRelationState; relationStates-&gt;ControlFunctions::forAll { in rs2 : BinaryRelationState; rs1 != rs2 implies rs1.relation != rs2.relation } }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint ComponentBelongToSystem: componentStates-&gt;ControlFunctions::forAll { in es : EntityState; entity.components-&gt;SequenceFunctions::includes(es.entity) }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint ComponentStatesAtSystemTime: componentStates-&gt;ControlFunctions::forAll { in es : EntityState; es.timeInstant == timeInstant }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint RelationStatesAtSystemTime: relationStates-&gt;ControlFunctions::forAll { in rs : BinaryRelationState; rs.timeInstant == timeInstant }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint RelationsBelongToSystem: relationStates-&gt;ControlFunctions::forAll { in rs : BinaryRelationState; entity.relations-&gt;SequenceFunctions::includes(rs.relation) }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">system state</rdfs:label>
        <skos:altLabel xml:lang="en">SystemState</skos:altLabel>
        <skos:definition xml:lang="en">The state of a system at a time instant is the complete set of attribute values describing the current condition of its components and their relations.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SystemTrajectory -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SystemTrajectory">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#states"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#SystemState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#system"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#timeInterval"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#TimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>occurrence def</sysmlKind>
        <sysmlName>CSBase::SystemTrajectory</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint ConsistentWithSystem: states-&gt;ControlFunctions::forAll { in st : SystemState; st.entity == system }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint StateTimesUseIntervalTimeScale: states-&gt;ControlFunctions::forAll { in st : SystemState; st.timeInstant.mRef == timeInterval.initialTime.mRef }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint StateTimesWithinInterval: states-&gt;ControlFunctions::forAll { in st : SystemState; timeInterval.initialTime &lt;= st.timeInstant and st.timeInstant &lt;= timeInterval.finalTime }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint StrictlyIncreasingTime: SequenceFunctions::size(states) == 1 or (1..(SequenceFunctions::size(states) - 1))-&gt;ControlFunctions::forAll { in i : Natural; states#(i).timeInstant &lt; states#(i + 1).timeInstant }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">system trajectory</rdfs:label>
        <skos:altLabel xml:lang="en">SystemTrajectory</skos:altLabel>
        <skos:definition xml:lang="en">A trajectory is a time-ordered sequence of states representing one possible evolution of the system over a time interval.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Task -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Task">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#goals"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#plannedActions"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>action def</sysmlKind>
        <sysmlName>CSBase::Task</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint GoalsOfSameExtendedSystem: goals-&gt;ControlFunctions::forAll { in g : Goal; g.extendedSystem == extendedSystem }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">task</rdfs:label>
        <skos:altLabel xml:lang="en">Task</skos:altLabel>
        <skos:definition xml:lang="en">A task is a set of planned actions, executed by one or more agents, that is intended to contribute to the achievement of one or more goals within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#TaskRequiresSystemCapability -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#TaskRequiresSystemCapability">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#capability"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Capability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#task"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <sysmlKind>connection def</sysmlKind>
        <sysmlName>CSBase::TaskRequiresSystemCapability</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint SameSystem: capability.system == task.extendedSystem.targetSystem</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">task requires system capability</rdfs:label>
        <skos:altLabel xml:lang="en">TaskRequiresSystemCapability</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#TimeInterval -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#TimeInterval">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#finalTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#initialTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <sysmlKind>attribute def</sysmlKind>
        <sysmlName>CSBase::TimeInterval</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint SameTimeScale: initialTime.mRef == finalTime.mRef</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint ValidInterval: initialTime &lt; finalTime</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">time interval</rdfs:label>
        <skos:altLabel xml:lang="en">TimeInterval</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Trigger -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Trigger">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#condition"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#TriggerCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>abstract item def</sysmlKind>
        <sysmlName>CSActionControl::Trigger</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">trigger</rdfs:label>
        <skos:altLabel xml:lang="en">Trigger</skos:altLabel>
        <skos:definition xml:lang="en">An action trigger is a condition on the state and/or exhibited behavior of an extended system, identified within a given context, whose satisfaction indicates the need to initiate the execution of one or more actions to contribute to the achievement or maintenance of one or more goals.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#TriggerCondition -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#TriggerCondition">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#triggerContext"/>

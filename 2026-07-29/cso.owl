                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Role"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <sysmlKind>connection def</sysmlKind>
        <sysmlName>CSBase::ContributesToBehavior</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">contributes to behavior</rdfs:label>
        <skos:altLabel xml:lang="en">ContributesToBehavior</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ContributesToFunction -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ContributesToFunction">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#function"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#role"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Role"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <sysmlKind>connection def</sysmlKind>
        <sysmlName>CSBase::ContributesToFunction</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">contributes to function</rdfs:label>
        <skos:altLabel xml:lang="en">ContributesToFunction</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Data -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Data">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#rawValues"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Data</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">data</rdfs:label>
        <skos:altLabel xml:lang="en">Data</skos:altLabel>
        <skos:definition xml:lang="en">Data are encoded representations of aspects of an entity or system (e.g., phenomena, properties, states, or attributes) in a form suitable for communication, storage, or processing.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Desire -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Desire">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#what"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#who"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Stakeholder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>connection def</sysmlKind>
        <sysmlName>CSBase::Desire</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">desire</rdfs:label>
        <skos:altLabel xml:lang="en">Desire</skos:altLabel>
        <skos:definition xml:lang="en">The relationship between stakeholder and goal is &quot;to desire&quot;.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Engine -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Engine">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#exerts"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Exert"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#modelets"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>abstract part def</sysmlKind>
        <sysmlName>CSCore::Engine</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint ExertionUseTheseModelets: exerts-&gt;ControlFunctions::forAll { in x : Exert; x.modelets-&gt;ControlFunctions::forAll { in m : Modelet; modelets-&gt;SequenceFunctions::includes(m) } }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint ExertionUseThisEngine: exerts-&gt;ControlFunctions::forAll { in x : Exert; x.engine == self }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">engine</rdfs:label>
        <skos:altLabel xml:lang="en">Engine</skos:altLabel>
        <skos:definition xml:lang="en">An engine is a component that exerts a modelet to derive a result.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Entity -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Entity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>abstract item def</sysmlKind>
        <sysmlName>CSBase::Entity</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">entity</rdfs:label>
        <skos:altLabel xml:lang="en">Entity</skos:altLabel>
        <skos:definition xml:lang="en">An entity is any thing in the universe of discourse that can be distinguished from all other things in that universe.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#EntityState -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#EntityState">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#entity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#timeInstant"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>occurrence def</sysmlKind>
        <sysmlName>CSBase::EntityState</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">entity state</rdfs:label>
        <skos:altLabel xml:lang="en">EntityState</skos:altLabel>
        <skos:definition xml:lang="en">The state of an entity at a given time instant is the tuple of the values of its attributes.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Environment -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Environment">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#entities"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#system"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Environment</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint DisjointWithSystem: entities-&gt;ControlFunctions::forAll { in e : Entity; e != system and not system.components-&gt;SequenceFunctions::includes(e) }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">environment</rdfs:label>
        <skos:altLabel xml:lang="en">Environment</skos:altLabel>
        <skos:definition xml:lang="en">The environment of a system is the collection of entities that are not part of the system but are capable of influencing or being influenced by it.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#EpistemicState -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#EpistemicState">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#EpistemicState_Evidenced"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#EpistemicState_Limited"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#EpistemicState_Uncertain"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#EpistemicState_Validated"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <sysmlKind>enum def</sysmlKind>
        <sysmlName>CSCore::EpistemicState</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">epistemic state</rdfs:label>
        <skos:altLabel xml:lang="en">EpistemicState</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Estimation -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Estimation">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#CognitiveFunction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#modelets"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#realizedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ModeletEnginePair"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#referent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::Estimation</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">estimation</rdfs:label>
        <skos:altLabel xml:lang="en">Estimation</skos:altLabel>
        <skos:definition xml:lang="en">Estimation is a cognitive function realized by a modelet-engine pair whose purpose is to infer unknown or uncertain quantities of a referent from available data and prior knowledge.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Evaluation -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Evaluation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#goals"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#performance"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#PerformanceMeasure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#risks"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#projection"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Projection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::Evaluation</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint GoalsMatchExtendedSystem: goals-&gt;ControlFunctions::forAll { in g : Goal; g.extendedSystem == extendedSystem }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint PerformanceUseSameContext: performance-&gt;ControlFunctions::forAll { in p : PerformanceMeasure; p.context == context }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint RisksUseSameContext: risks-&gt;ControlFunctions::forAll { in r : Risk; r.context == context }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">evaluation</rdfs:label>
        <skos:altLabel xml:lang="en">Evaluation</skos:altLabel>
        <skos:definition xml:lang="en">Evaluation is an assessment of a projection with respect to a specific set of goals.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Event -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Event">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#posteriorState"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#SystemState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#priorState"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#SystemState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>occurrence def</sysmlKind>
        <sysmlName>CSBase::Event</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint Instantaneous: startShot == endShot</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint StatesOfThisExtendedSystem: priorState-&gt;ControlFunctions::forAll { in st : SystemState; st.entity == extendedSystem }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">event</rdfs:label>
        <skos:altLabel xml:lang="en">Event</skos:altLabel>
        <skos:definition xml:lang="en">An event is an occurrence that represents a change in an extended system.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Exert -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Exert">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#modelets"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#engine"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Engine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#inputs"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#results"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>action def</sysmlKind>
        <sysmlName>CSCore::Exert</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">exert</rdfs:label>
        <skos:altLabel xml:lang="en">Exert</skos:altLabel>
        <skos:definition xml:lang="en">Exertion is the process of executing one or more modelets to given inputs in order to derive results about their referent.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ExhibitedBehavior -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ExhibitedBehavior">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#system"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#timeInterval"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#TimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#trajectory"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#SystemTrajectory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::ExhibitedBehavior</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">exhibited behavior</rdfs:label>
        <skos:altLabel xml:lang="en">ExhibitedBehavior</skos:altLabel>
        <skos:definition xml:lang="en">The exhibited behavior of a system over an observational interval is the trajectory followed by the system during that interval.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ExtendedSystem -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ExtendedSystem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#System"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#environmentEntities"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#systemEnvironmentRelations"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#BinaryRelation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#environment"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Environment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#targetSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>part def</sysmlKind>
        <sysmlName>CSBase::ExtendedSystem</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint ComponentsAreExactlyTargetAndEnvironment: components-&gt;ControlFunctions::forAll { in c : Entity; c == targetSystem or environmentEntities-&gt;SequenceFunctions::includes(c) }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint EnvironmentEntitySetMatches: environment.entities-&gt;ControlFunctions::forAll { in e : Entity; environmentEntities-&gt;SequenceFunctions::includes(e) } and environmentEntities-&gt;ControlFunctions::forAll { in e : Entity; environment.entities-&gt;SequenceFunctions::includes(e) }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint EnvironmentMatchesTargetSystem: environment.system == targetSystem</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint OnlySERelations: systemEnvironmentRelations-&gt;ControlFunctions::forAll { in r : BinaryRelation; (r.source == targetSystem and environmentEntities-&gt;SequenceFunctions::includes(r.target)) or (r.target == targetSystem and environmentEntities-&gt;SequenceFunctions::includes(r.source)) }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint RelationsAreExactlySERelations: relations-&gt;ControlFunctions::forAll { in r : BinaryRelation; systemEnvironmentRelations-&gt;SequenceFunctions::includes(r) }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">extended system</rdfs:label>
        <skos:altLabel xml:lang="en">ExtendedSystem</skos:altLabel>
        <skos:definition xml:lang="en">An extended system is composed of a target system together with its selected environment and the relations between both of them.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Feature -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Feature">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#entity"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#phenomenon"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Phenomenon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#information"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::Feature</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">feature</rdfs:label>
        <skos:altLabel xml:lang="en">Feature</skos:altLabel>
        <skos:definition xml:lang="en">A feature is a derived piece of information that encodes some characteristic of an entity, system, phenomenon, or context, obtained from observations or sensor data and used as input to functions or modelets.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Function -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Function">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#inputs"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#outputs"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Function</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">function</rdfs:label>
        <skos:altLabel xml:lang="en">Function</skos:altLabel>
        <skos:definition xml:lang="en">A function is a transformation that maps specific inputs to outputs.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Functionality -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Functionality">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#actions"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#expectedPerformance"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#PerformanceMeasure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#goals"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#capability"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Capability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#object"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Functionality</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint ExpectedPerformanceConsistent: expectedPerformance-&gt;ControlFunctions::forAll { in pm : PerformanceMeasure; pm.context.extendedSystem == context.extendedSystem and pm.object == object }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint GoalsOfSameExtendedSystem: goals-&gt;ControlFunctions::forAll { in g : Goal; g.extendedSystem == context.extendedSystem }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint ObjectWithinExtendedSystem: object == context.extendedSystem or context.extendedSystem.targetSystem.components-&gt;SequenceFunctions::includes(object)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">functionality</rdfs:label>
        <skos:altLabel xml:lang="en">Functionality</skos:altLabel>
        <skos:definition xml:lang="en">A functionality is an instantiation of a capability with some expected performance that is intended to satisfy one or more goals within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Goal -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Goal">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#desiredStates"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#SystemState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Goal</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint DesiredStatesAreOfThisExtendedSystem: desiredStates-&gt;ControlFunctions::forAll { in st : SystemState; st.entity == extendedSystem }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">goal</rdfs:label>
        <skos:altLabel xml:lang="en">Goal</skos:altLabel>
        <skos:definition xml:lang="en">A goal is a subset of the possible states of an extended system representing the conditions that an agent intends to achieve or maintain.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Interest -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Interest">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#on"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#who"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Stakeholder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <sysmlKind>connection def</sysmlKind>
        <sysmlName>CSBase::Interest</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">interest</rdfs:label>
        <skos:altLabel xml:lang="en">Interest</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ManifestCapability -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ManifestCapability">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#behavior"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExhibitedBehavior"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#capability"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Capability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <sysmlKind>connection def</sysmlKind>
        <sysmlName>CSBase::ManifestCapability</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint SameSystem: behavior.system == capability.system</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">manifest capability</rdfs:label>
        <skos:altLabel xml:lang="en">ManifestCapability</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Meaning -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Meaning">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#inputFeatures"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#modelets"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#description"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::Meaning</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint FeaturesMatchExtendedSystem: inputFeatures-&gt;ControlFunctions::forAll { in f : Feature; f.extendedSystem == extendedSystem }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">meaning</rdfs:label>
        <skos:altLabel xml:lang="en">Meaning</skos:altLabel>
        <skos:definition xml:lang="en">Meaning is the informational content produced by exerting one or more modelets on input features, representing an interpretation of a phenomenon of the associated extended system within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Metric -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Metric">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#category"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#PerformanceMeasureType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#name"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#description"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Metric</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint NameNonEmpty: name != &quot;&quot;</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">metric</rdfs:label>
        <skos:altLabel xml:lang="en">Metric</skos:altLabel>
        <skos:definition xml:lang="en">A metric is a measure used to assess mission success.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Mission -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Mission">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#desiredEffects"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::Mission</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">mission</rdfs:label>
        <skos:altLabel xml:lang="en">Mission</skos:altLabel>
        <skos:definition xml:lang="en">A mission is a high-level goal expressed as desired effects or target conditions for an extended system within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#MissionPlan -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#MissionPlan">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#tasks"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#mission"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Mission"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#performedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>action def</sysmlKind>
        <sysmlName>CSBase::MissionPlan</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint MissionContextMatchesPlanContext: mission.context == context</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint TasksUseSameContext: tasks-&gt;ControlFunctions::forAll { in t : Task; t.context == context }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">mission plan</rdfs:label>
        <skos:altLabel xml:lang="en">MissionPlan</skos:altLabel>
        <skos:definition xml:lang="en">A mission plan is a collection of tasks, together with any required precedence relations among them, to be carried out in order to satisfy the mission within the given extended system and context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#MissionSpecification -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#MissionSpecification">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#goals"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#successCriteria"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#MissionSuccessCriterion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#extendedSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#mission"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Mission"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::MissionSpecification</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint GoalsConsistentWithMission: goals-&gt;ControlFunctions::forAll { in g : Goal; g.extendedSystem == extendedSystem }</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">mission specification</rdfs:label>
        <skos:altLabel xml:lang="en">MissionSpecification</skos:altLabel>
        <skos:definition xml:lang="en">A mission specification is the set of specific goals refining a given mission, together with the mission success criteria (expressed as metrics and their satisfaction conditions) that enable assessment of mission success.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#MissionSuccessCriterion -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#MissionSuccessCriterion">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#metric"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Metric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#satisfactionCondition"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSBase::MissionSuccessCriterion</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">mission success criterion</rdfs:label>
        <skos:altLabel xml:lang="en">MissionSuccessCriterion</skos:altLabel>
        <skos:definition xml:lang="en">A mission success criterion pairs a metric with a satisfaction condition in a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Model -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Model">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#modelets"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#modeltype"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ModelType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#referent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#usedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#isComposable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#isExertableOnItsOwn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#isActionable"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>abstract part def</sysmlKind>
        <sysmlName>CSCore::Model</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>

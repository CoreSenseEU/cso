    <owl:Class rdf:about="http://w3id.org/coresense/cso#Understanding">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#CognitiveCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#usefulModels"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#understoodPhenomenon"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Phenomenon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::Understanding</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">understanding</rdfs:label>
        <skos:altLabel xml:lang="en">Understanding</skos:altLabel>
        <skos:definition xml:lang="en">Understanding is the capability of an entity to construct and use models of a phenomenon or system in order to make reliable inferences about it.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#WorldModel -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#WorldModel">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Model"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#referent"/>

        <sysmlKind>abstract part def</sysmlKind>
        <sysmlName>CSCore::WorldModel</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint UsedByInTargetOrEnvironment: referent.targetSystem.components-&gt;SequenceFunctions::includes(usedBy) or referent.environmentEntities-&gt;SequenceFunctions::includes(usedBy)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">world model</rdfs:label>
        <skos:altLabel xml:lang="en">WorldModel</skos:altLabel>
        <skos:definition xml:lang="en">A WorldModel is a Model whose referent is the ExtendedSystem being operated in.</skos:definition>
    </owl:Class>
    



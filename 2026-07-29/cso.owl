        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Event"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#context"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#status"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ActionStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#terminatedAction"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>occurrence def</sysmlKind>
        <sysmlName>CSActionControl::ActionEnd</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint IsEndShotOfAction: self == terminatedAction.endShot</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action end</rdfs:label>
        <skos:altLabel xml:lang="en">ActionEnd</skos:altLabel>
        <skos:definition xml:lang="en">An action end is an event that, within a given context, marks the termination of the execution of an action, together with a termination status value.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ActionOrder -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ActionOrder">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#assignee"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#assignment"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ActionAssignedTo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#specification"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ActionSpecification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSActionControl::ActionOrder</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action order</rdfs:label>
        <skos:altLabel xml:lang="en">ActionOrder</skos:altLabel>
        <skos:definition xml:lang="en">An action order is an executable directive, issued within a given context of an extended system, that activates the execution of the actions in a given action specification by the designated agents.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ActionOrderStatus -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ActionOrderStatus">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#order"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ActionOrder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#status"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ActionStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSActionControl::ActionOrderStatus</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action order status</rdfs:label>
        <skos:altLabel xml:lang="en">ActionOrderStatus</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ActionSpecification -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ActionSpecification">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#assignments"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#ActionAssignedTo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSActionControl::ActionSpecification</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action specification</rdfs:label>
        <skos:altLabel xml:lang="en">ActionSpecification</skos:altLabel>
        <skos:definition xml:lang="en">An action specification is a concrete description, produced in response to an action trigger within a given context according to a chosen policy, that: (i) selects one or more actions from the candidate set determined by that policy, and (ii) assigns one or more responsible agents to each selected action.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ActionStatus -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ActionStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ActionStatus_aborted"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ActionStatus_failed"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ActionStatus_notTriggered"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ActionStatus_succeeded"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#ActionStatus_timedOut"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <sysmlKind>enum def</sysmlKind>
        <sysmlName>CSActionControl::ActionStatus</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action status</rdfs:label>
        <skos:altLabel xml:lang="en">ActionStatus</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Actuator -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Actuator">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#commandedBy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#executes"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>abstract part def</sysmlKind>
        <sysmlName>CSBase::Actuator</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">actuator</rdfs:label>
        <skos:altLabel xml:lang="en">Actuator</skos:altLabel>
        <skos:definition xml:lang="en">An actuator is a physical entity that, when provided with an input, produces a physical effect on the environment or the system (e.g., motion, force, or flow), thereby executing actions commanded by an agent.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#AdverseOccurrence -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#AdverseOccurrence">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <sysmlKind>occurrence def</sysmlKind>
        <sysmlName>CSBase::AdverseOccurrence</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">adverse occurrence</rdfs:label>
        <skos:altLabel xml:lang="en">AdverseOccurrence</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Agent -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Agent">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#commands"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#executes"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>abstract part def</sysmlKind>
        <sysmlName>CSBase::Agent</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint HasAtLeastOneActionRole: SequenceFunctions::size(executes) &gt; 0 or SequenceFunctions::size(commands) &gt; 0</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">agent</rdfs:label>
        <skos:altLabel xml:lang="en">Agent</skos:altLabel>
        <skos:definition xml:lang="en">An agent is an entity capable of executing or commanding actions.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Awareness -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Awareness">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#CognitiveCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#updatingSenses"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Sense"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#awarePhenomenon"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Phenomenon"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#maintainedUnderstanding"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Understanding"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>item def</sysmlKind>
        <sysmlName>CSCore::Awareness</sysmlName>
        <rdfs:comment xml:lang="en">SysML constraint SensingHappensDuringAwareness: updatingSenses-&gt;ControlFunctions::forAll { in sn : Sense; self.timeEnclosedOccurrences-&gt;SequenceFunctions::includes(sn) }</rdfs:comment>
        <rdfs:comment xml:lang="en">SysML constraint UnderstandingOfSamePhenomenon: maintainedUnderstanding.understoodPhenomenon == awarePhenomenon</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">awareness</rdfs:label>
        <skos:altLabel xml:lang="en">Awareness</skos:altLabel>
        <skos:definition xml:lang="en">Awareness is the capability of an entity to maintain timely understanding of a phenomenon and its implications for the entity.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#BinaryRelation -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#BinaryRelation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#source"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#target"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"/>
        <sysmlKind>connection def</sysmlKind>
        <sysmlName>CSBase::BinaryRelation</sysmlName>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">binary relation</rdfs:label>
        <skos:altLabel xml:lang="en">BinaryRelation</skos:altLabel>
        <skos:definition xml:lang="en">Binary relation between two entities.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#BinaryRelationState -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#BinaryRelationState">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#relation"/>

###  http://w3id.org/coresense/cso#ActionAssignedTo
:ActionAssignedTo rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :agent ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Agent
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :assigned_action ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Action
                                  ] ;
                  :sysmlKind "allocation def" ;
                  :sysmlName "CSActionControl::ActionAssignedTo" ;
                  rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                  rdfs:label "action assigned to"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "ActionAssignedTo"@en .


###  http://w3id.org/coresense/cso#ActionEnd
:ActionEnd rdf:type owl:Class ;
           rdfs:subClassOf :Event ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :context ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Context
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :status ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :ActionStatus
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :terminatedAction ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Action
                           ] ;
           <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
           :sysmlKind "occurrence def" ;
           :sysmlName "CSActionControl::ActionEnd" ;
           rdfs:comment "SysML constraint IsEndShotOfAction: self == terminatedAction.endShot"@en ;
           rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
           rdfs:label "action end"@en ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "ActionEnd"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "An action end is an event that, within a given context, marks the termination of the execution of an action, together with a termination status value."@en .


###  http://w3id.org/coresense/cso#ActionOrder
:ActionOrder rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :assignee ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Agent
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :assignment ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :ActionAssignedTo
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :specification ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :ActionSpecification
                             ] ;
             <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
             :sysmlKind "item def" ;
             :sysmlName "CSActionControl::ActionOrder" ;
             rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
             rdfs:label "action order"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "ActionOrder"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "An action order is an executable directive, issued within a given context of an extended system, that activates the execution of the actions in a given action specification by the designated agents."@en .



###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://w3id.org/coresense/cso#sysmlKind
:sysmlKind rdf:type owl:AnnotationProperty ;
           rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
           rdfs:label "SysML definition kind"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "The SysML v2 definition keyword this term was generated from."@en .


###  http://w3id.org/coresense/cso#sysmlName
:sysmlName rdf:type owl:AnnotationProperty ;
           rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
           rdfs:label "SysML qualified name"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "The fully qualified name of the SysML v2 element this term was generated from."@en .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .



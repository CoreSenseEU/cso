                     :sysmlKind "item def" ;
                     :sysmlName "CSActionControl::ActionSpecification" ;
                     rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                     rdfs:label "action specification"@en ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "ActionSpecification"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "An action specification is a concrete description, produced in response to an action trigger within a given context according to a chosen policy, that: (i) selects one or more actions from the candidate set determined by that policy, and (ii) assigns one or more responsible agents to each selected action."@en .


###  http://w3id.org/coresense/cso#ActionStatus
:ActionStatus rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( :ActionStatus_aborted
                                                :ActionStatus_failed
                                                :ActionStatus_notTriggered
                                                :ActionStatus_succeeded
                                                :ActionStatus_timedOut
                                              )
                                  ] ;
              rdfs:subClassOf owl:Thing ;
              :sysmlKind "enum def" ;
              :sysmlName "CSActionControl::ActionStatus" ;
              rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
              rdfs:label "action status"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "ActionStatus"@en .


###  http://w3id.org/coresense/cso#Actuator
:Actuator rdf:type owl:Class ;
          rdfs:subClassOf :Entity ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :commandedBy ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Agent
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :executes ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Action
                          ] ;
          <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
          :sysmlKind "abstract part def" ;
          :sysmlName "CSBase::Actuator" ;
          rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
          rdfs:label "actuator"@en ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Actuator"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "An actuator is a physical entity that, when provided with an input, produces a physical effect on the environment or the system (e.g., motion, force, or flow), thereby executing actions commanded by an agent."@en .


###  http://w3id.org/coresense/cso#AdverseOccurrence
:AdverseOccurrence rdf:type owl:Class ;
                   rdfs:subClassOf owl:Thing ;
                   :sysmlKind "occurrence def" ;
                   :sysmlName "CSBase::AdverseOccurrence" ;
                   rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                   rdfs:label "adverse occurrence"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "AdverseOccurrence"@en .


###  http://w3id.org/coresense/cso#Agent
:Agent rdf:type owl:Class ;
       rdfs:subClassOf :Entity ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :commands ;
                         owl:allValuesFrom :Action
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :executes ;
                         owl:allValuesFrom :Action
                       ] ;
       <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
       :sysmlKind "abstract part def" ;
       :sysmlName "CSBase::Agent" ;
       rdfs:comment "SysML constraint HasAtLeastOneActionRole: SequenceFunctions::size(executes) > 0 or SequenceFunctions::size(commands) > 0"@en ;
       rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
       rdfs:label "agent"@en ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "Agent"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "An agent is an entity capable of executing or commanding actions."@en .


###  http://w3id.org/coresense/cso#Awareness
:Awareness rdf:type owl:Class ;
           rdfs:subClassOf :CognitiveCapability ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :updatingSenses ;
                             owl:allValuesFrom :Sense
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :awarePhenomenon ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Phenomenon
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :maintainedUnderstanding ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Understanding
                           ] ;
           <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
           :sysmlKind "item def" ;
           :sysmlName "CSCore::Awareness" ;
           rdfs:comment "SysML constraint SensingHappensDuringAwareness: updatingSenses->ControlFunctions::forAll { in sn : Sense; self.timeEnclosedOccurrences->SequenceFunctions::includes(sn) }"@en ,
                        "SysML constraint UnderstandingOfSamePhenomenon: maintainedUnderstanding.understoodPhenomenon == awarePhenomenon"@en ;
           rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
           rdfs:label "awareness"@en ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "Awareness"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "Awareness is the capability of an entity to maintain timely understanding of a phenomenon and its implications for the entity."@en .


###  http://w3id.org/coresense/cso#BinaryRelation
:BinaryRelation rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :source ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Entity
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :target ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Entity
                                ] ;
                <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                :sysmlKind "connection def" ;
                :sysmlName "CSBase::BinaryRelation" ;
                rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                rdfs:label "binary relation"@en ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "BinaryRelation"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Binary relation between two entities."@en .


###  http://w3id.org/coresense/cso#BinaryRelationState
:BinaryRelationState rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :relation ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :BinaryRelation
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :source ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Entity
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :target ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Entity
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :timeInstant ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:dateTime
                                     ] ;
                     <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                     :sysmlKind "occurrence def" ;
                     :sysmlName "CSBase::BinaryRelationState" ;
                     rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                     rdfs:label "binary relation state"@en ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "BinaryRelationState"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The state of a BinaryRelation at a given time instant is the tuple of the values of its attributes."@en .


###  http://w3id.org/coresense/cso#Capability
:Capability rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :realizes ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Function
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :system ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :System
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :acceptanceCriteria ;
                              owl:allValuesFrom xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :conditions ;
                              owl:allValuesFrom xsd:string
                            ] ;
            <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
            :sysmlKind "item def" ;
            :sysmlName "CSBase::Capability" ;
            rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
            rdfs:label "capability"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Capability"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A capability is the ability of a system to perform a specific function successfully under stated conditions and acceptance criteria."@en .


###  http://w3id.org/coresense/cso#CognitiveCapability
:CognitiveCapability rdf:type owl:Class ;
                     rdfs:subClassOf :Capability ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :modelets ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Modelet
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :realizes ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :CognitiveFunction
                                     ] ;
                     <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                     :sysmlKind "item def" ;
                     :sysmlName "CSCore::CognitiveCapability" ;
                     rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                     rdfs:label "cognitive capability"@en ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "CognitiveCapability"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A cognitive capability is a capability of a system that is realized by a cognitive function and enables the system to use knowledge to produce intentional action."@en .


###  http://w3id.org/coresense/cso#CognitiveFunction
:CognitiveFunction rdf:type owl:Class ;
                   rdfs:subClassOf :Function ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :modelets ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Modelet
                                   ] ;
                   <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                   :sysmlKind "item def" ;
                   :sysmlName "CSCore::CognitiveFunction" ;
                   rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                   rdfs:label "cognitive function"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "CognitiveFunction"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A cognitive function is a function that processes information by executing one or more modelets."@en .


###  http://w3id.org/coresense/cso#Concern
:Concern rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :context ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Context
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :sh ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Stakeholder
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :description ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ;
         <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
         :sysmlKind "item def" ;
         :sysmlName "CSBase::Concern" ;
         rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
         rdfs:label "concern"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Concern"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A concern is a matter of interest to a stakeholder that, in a given context, can be derived from a need and may give rise to requirements."@en .


###  http://w3id.org/coresense/cso#Context
:Context rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :extendedSystem ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :ExtendedSystem
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :conditions ;
                           owl:allValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :knowledge ;
                           owl:allValuesFrom xsd:string
                         ] ;
         <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
         :sysmlKind "item def" ;
         :sysmlName "CSBase::Context" ;
         rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
         rdfs:label "context"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Context"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "Given an extended system, the context is the set of the content retained about that extended system, together with the assumptions and conditions, deemed relevant to interpret, evaluate and act within that extended system."@en .


###  http://w3id.org/coresense/cso#ContributesToBehavior
:ContributesToBehavior rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :behavior ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :PotentialBehavior
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :role ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Role
                                       ] ;
                       :sysmlKind "connection def" ;
                       :sysmlName "CSBase::ContributesToBehavior" ;
                       rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                       rdfs:label "contributes to behavior"@en ;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "ContributesToBehavior"@en .


###  http://w3id.org/coresense/cso#ContributesToFunction
:ContributesToFunction rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :function ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Function
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :role ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Role
                                       ] ;
                       :sysmlKind "connection def" ;
                       :sysmlName "CSBase::ContributesToFunction" ;
                       rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                       rdfs:label "contributes to function"@en ;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "ContributesToFunction"@en .


###  http://w3id.org/coresense/cso#Data
:Data rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :extendedSystem ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :ExtendedSystem
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :rawValues ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                      ] ;
      <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
      :sysmlKind "item def" ;
      :sysmlName "CSBase::Data" ;
      rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
      rdfs:label "data"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "Data"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "Data are encoded representations of aspects of an entity or system (e.g., phenomena, properties, states, or attributes) in a form suitable for communication, storage, or processing."@en .


###  http://w3id.org/coresense/cso#Desire
:Desire rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :what ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Goal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :who ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Stakeholder
                        ] ;
        <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
        :sysmlKind "connection def" ;
        :sysmlName "CSBase::Desire" ;
        rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
        rdfs:label "desire"@en ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "Desire"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "The relationship between stakeholder and goal is \"to desire\"."@en .


###  http://w3id.org/coresense/cso#Engine
:Engine rdf:type owl:Class ;
        rdfs:subClassOf :Entity ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :exerts ;
                          owl:allValuesFrom :Exert
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :modelets ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Modelet
                        ] ;
        <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
        :sysmlKind "abstract part def" ;
        :sysmlName "CSCore::Engine" ;
        rdfs:comment "SysML constraint ExertionUseTheseModelets: exerts->ControlFunctions::forAll { in x : Exert; x.modelets->ControlFunctions::forAll { in m : Modelet; modelets->SequenceFunctions::includes(m) } }"@en ,
                     "SysML constraint ExertionUseThisEngine: exerts->ControlFunctions::forAll { in x : Exert; x.engine == self }"@en ;
        rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
        rdfs:label "engine"@en ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "Engine"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "An engine is a component that exerts a modelet to derive a result."@en .


###  http://w3id.org/coresense/cso#Entity
:Entity rdf:type owl:Class ;
        rdfs:subClassOf owl:Thing ;
        <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
        :sysmlKind "abstract item def" ;
        :sysmlName "CSBase::Entity" ;
        rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
        rdfs:label "entity"@en ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "Entity"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "An entity is any thing in the universe of discourse that can be distinguished from all other things in that universe."@en .


###  http://w3id.org/coresense/cso#EntityState
:EntityState rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :entity ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Entity
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :timeInstant ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:dateTime
                             ] ;
             <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
             :sysmlKind "occurrence def" ;
             :sysmlName "CSBase::EntityState" ;
             rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
             rdfs:label "entity state"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "EntityState"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "The state of an entity at a given time instant is the tuple of the values of its attributes."@en .


###  http://w3id.org/coresense/cso#Environment
:Environment rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :entities ;
                               owl:allValuesFrom :Entity
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :system ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :System
                             ] ;
             <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
             :sysmlKind "item def" ;
             :sysmlName "CSBase::Environment" ;
             rdfs:comment "SysML constraint DisjointWithSystem: entities->ControlFunctions::forAll { in e : Entity; e != system and not system.components->SequenceFunctions::includes(e) }"@en ;
             rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
             rdfs:label "environment"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Environment"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "The environment of a system is the collection of entities that are not part of the system but are capable of influencing or being influenced by it."@en .


###  http://w3id.org/coresense/cso#EpistemicState
:EpistemicState rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( :EpistemicState_Evidenced
                                                  :EpistemicState_Limited
                                                  :EpistemicState_Uncertain
                                                  :EpistemicState_Validated
                                                )
                                    ] ;
                rdfs:subClassOf owl:Thing ;
                :sysmlKind "enum def" ;
                :sysmlName "CSCore::EpistemicState" ;
                rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                rdfs:label "epistemic state"@en ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "EpistemicState"@en .


###  http://w3id.org/coresense/cso#Estimation
:Estimation rdf:type owl:Class ;
            rdfs:subClassOf :CognitiveFunction ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :modelets ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Modelet
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :realizedBy ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :ModeletEnginePair
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :referent ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Entity
                            ] ;
            <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
            :sysmlKind "item def" ;
            :sysmlName "CSCore::Estimation" ;
            rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
            rdfs:label "estimation"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Estimation"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Estimation is a cognitive function realized by a modelet-engine pair whose purpose is to infer unknown or uncertain quantities of a referent from available data and prior knowledge."@en .


###  http://w3id.org/coresense/cso#Evaluation
:Evaluation rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :goals ;
                              owl:allValuesFrom :Goal
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :performance ;
                              owl:allValuesFrom :PerformanceMeasure
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :risks ;
                              owl:allValuesFrom :Risk
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :context ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Context
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :extendedSystem ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :ExtendedSystem
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :projection ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Projection
                            ] ;
            <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
            :sysmlKind "item def" ;
            :sysmlName "CSCore::Evaluation" ;
            rdfs:comment "SysML constraint GoalsMatchExtendedSystem: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == extendedSystem }"@en ,
                         "SysML constraint PerformanceUseSameContext: performance->ControlFunctions::forAll { in p : PerformanceMeasure; p.context == context }"@en ,
                         "SysML constraint RisksUseSameContext: risks->ControlFunctions::forAll { in r : Risk; r.context == context }"@en ;
            rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
            rdfs:label "evaluation"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Evaluation"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Evaluation is an assessment of a projection with respect to a specific set of goals."@en .


###  http://w3id.org/coresense/cso#Event
:Event rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :extendedSystem ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :ExtendedSystem
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :posteriorState ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :SystemState
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :priorState ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :SystemState
                       ] ;
       <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
       :sysmlKind "occurrence def" ;
       :sysmlName "CSBase::Event" ;
       rdfs:comment "SysML constraint Instantaneous: startShot == endShot"@en ,
                    "SysML constraint StatesOfThisExtendedSystem: priorState->ControlFunctions::forAll { in st : SystemState; st.entity == extendedSystem }"@en ;
       rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
       rdfs:label "event"@en ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "Event"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "An event is an occurrence that represents a change in an extended system."@en .


###  http://w3id.org/coresense/cso#Exert
:Exert rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :modelets ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Modelet
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :engine ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Engine
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :inputs ;
                         owl:allValuesFrom rdfs:Literal
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :results ;
                         owl:allValuesFrom rdfs:Literal
                       ] ;
       <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
       :sysmlKind "action def" ;
       :sysmlName "CSCore::Exert" ;
       rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
       rdfs:label "exert"@en ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "Exert"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "Exertion is the process of executing one or more modelets to given inputs in order to derive results about their referent."@en .


###  http://w3id.org/coresense/cso#ExhibitedBehavior
:ExhibitedBehavior rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :system ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :System
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :timeInterval ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :TimeInterval
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :trajectory ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :SystemTrajectory
                                   ] ;
                   <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                   :sysmlKind "item def" ;
                   :sysmlName "CSBase::ExhibitedBehavior" ;
                   rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                   rdfs:label "exhibited behavior"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "ExhibitedBehavior"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The exhibited behavior of a system over an observational interval is the trajectory followed by the system during that interval."@en .


###  http://w3id.org/coresense/cso#ExtendedSystem
:ExtendedSystem rdf:type owl:Class ;
                rdfs:subClassOf :System ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :environmentEntities ;
                                  owl:allValuesFrom :Entity
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :systemEnvironmentRelations ;
                                  owl:allValuesFrom :BinaryRelation
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :environment ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Environment
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :targetSystem ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :System
                                ] ;
                <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                :sysmlKind "part def" ;
                :sysmlName "CSBase::ExtendedSystem" ;
                rdfs:comment "SysML constraint ComponentsAreExactlyTargetAndEnvironment: components->ControlFunctions::forAll { in c : Entity; c == targetSystem or environmentEntities->SequenceFunctions::includes(c) }"@en ,
                             "SysML constraint EnvironmentEntitySetMatches: environment.entities->ControlFunctions::forAll { in e : Entity; environmentEntities->SequenceFunctions::includes(e) } and environmentEntities->ControlFunctions::forAll { in e : Entity; environment.entities->SequenceFunctions::includes(e) }"@en ,
                             "SysML constraint EnvironmentMatchesTargetSystem: environment.system == targetSystem"@en ,
                             "SysML constraint OnlySERelations: systemEnvironmentRelations->ControlFunctions::forAll { in r : BinaryRelation; (r.source == targetSystem and environmentEntities->SequenceFunctions::includes(r.target)) or (r.target == targetSystem and environmentEntities->SequenceFunctions::includes(r.source)) }"@en ,
                             "SysML constraint RelationsAreExactlySERelations: relations->ControlFunctions::forAll { in r : BinaryRelation; systemEnvironmentRelations->SequenceFunctions::includes(r) }"@en ;
                rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                rdfs:label "extended system"@en ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "ExtendedSystem"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "An extended system is composed of a target system together with its selected environment and the relations between both of them."@en .


###  http://w3id.org/coresense/cso#Feature
:Feature rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :extendedSystem ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :ExtendedSystem
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :context ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Context
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :entity ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Entity
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :phenomenon ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Phenomenon
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :information ;
                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
         :sysmlKind "item def" ;
         :sysmlName "CSCore::Feature" ;
         rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
         rdfs:label "feature"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Feature"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A feature is a derived piece of information that encodes some characteristic of an entity, system, phenomenon, or context, obtained from observations or sensor data and used as input to functions or modelets."@en .


###  http://w3id.org/coresense/cso#Function
:Function rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :inputs ;
                            owl:allValuesFrom rdfs:Literal
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :outputs ;
                            owl:allValuesFrom rdfs:Literal
                          ] ;
          <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
          :sysmlKind "item def" ;
          :sysmlName "CSBase::Function" ;
          rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
          rdfs:label "function"@en ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Function"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A function is a transformation that maps specific inputs to outputs."@en .


###  http://w3id.org/coresense/cso#Functionality
:Functionality rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :actions ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Action
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :expectedPerformance ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :PerformanceMeasure
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :goals ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Goal
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :capability ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Capability
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :context ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Context
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :extendedSystem ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :ExtendedSystem
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :object ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Entity
                               ] ;
               <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
               :sysmlKind "item def" ;
               :sysmlName "CSBase::Functionality" ;
               rdfs:comment "SysML constraint ExpectedPerformanceConsistent: expectedPerformance->ControlFunctions::forAll { in pm : PerformanceMeasure; pm.context.extendedSystem == context.extendedSystem and pm.object == object }"@en ,
                            "SysML constraint GoalsOfSameExtendedSystem: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == context.extendedSystem }"@en ,
                            "SysML constraint ObjectWithinExtendedSystem: object == context.extendedSystem or context.extendedSystem.targetSystem.components->SequenceFunctions::includes(object)"@en ;
               rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
               rdfs:label "functionality"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Functionality"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "A functionality is an instantiation of a capability with some expected performance that is intended to satisfy one or more goals within a given context."@en .


###  http://w3id.org/coresense/cso#Goal
:Goal rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :desiredStates ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :SystemState
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :extendedSystem ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :ExtendedSystem
                      ] ;
      <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
      :sysmlKind "item def" ;
      :sysmlName "CSBase::Goal" ;
      rdfs:comment "SysML constraint DesiredStatesAreOfThisExtendedSystem: desiredStates->ControlFunctions::forAll { in st : SystemState; st.entity == extendedSystem }"@en ;
      rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
      rdfs:label "goal"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "Goal"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A goal is a subset of the possible states of an extended system representing the conditions that an agent intends to achieve or maintain."@en .


###  http://w3id.org/coresense/cso#Interest
:Interest rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :on ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :ExtendedSystem
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :who ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Stakeholder
                          ] ;
          :sysmlKind "connection def" ;
          :sysmlName "CSBase::Interest" ;
          rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
          rdfs:label "interest"@en ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Interest"@en .


###  http://w3id.org/coresense/cso#ManifestCapability
:ManifestCapability rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :behavior ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :ExhibitedBehavior
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :capability ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Capability
                                    ] ;
                    :sysmlKind "connection def" ;
                    :sysmlName "CSBase::ManifestCapability" ;
                    rdfs:comment "SysML constraint SameSystem: behavior.system == capability.system"@en ;
                    rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                    rdfs:label "manifest capability"@en ;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "ManifestCapability"@en .


###  http://w3id.org/coresense/cso#Meaning
:Meaning rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :inputFeatures ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Feature
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :modelets ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Modelet
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :context ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Context
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :extendedSystem ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :ExtendedSystem
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :description ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ;
         <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
         :sysmlKind "item def" ;
         :sysmlName "CSCore::Meaning" ;
         rdfs:comment "SysML constraint FeaturesMatchExtendedSystem: inputFeatures->ControlFunctions::forAll { in f : Feature; f.extendedSystem == extendedSystem }"@en ;
         rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
         rdfs:label "meaning"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Meaning"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "Meaning is the informational content produced by exerting one or more modelets on input features, representing an interpretation of a phenomenon of the associated extended system within a given context."@en .


###  http://w3id.org/coresense/cso#Metric
:Metric rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :category ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :PerformanceMeasureType
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :name ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :description ;
                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ;
        <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
        :sysmlKind "item def" ;
        :sysmlName "CSBase::Metric" ;
        rdfs:comment "SysML constraint NameNonEmpty: name != \"\""@en ;
        rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
        rdfs:label "metric"@en ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "Metric"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "A metric is a measure used to assess mission success."@en .


###  http://w3id.org/coresense/cso#Mission
:Mission rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :context ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Context
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :extendedSystem ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :ExtendedSystem
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :desiredEffects ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ;
         <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
         :sysmlKind "item def" ;
         :sysmlName "CSBase::Mission" ;
         rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
         rdfs:label "mission"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Mission"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A mission is a high-level goal expressed as desired effects or target conditions for an extended system within a given context."@en .


###  http://w3id.org/coresense/cso#MissionPlan
:MissionPlan rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :tasks ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Task
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :context ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Context
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :extendedSystem ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :ExtendedSystem
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :mission ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Mission
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :performedBy ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :System
                             ] ;
             <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
             :sysmlKind "action def" ;
             :sysmlName "CSBase::MissionPlan" ;
             rdfs:comment "SysML constraint MissionContextMatchesPlanContext: mission.context == context"@en ,
                          "SysML constraint TasksUseSameContext: tasks->ControlFunctions::forAll { in t : Task; t.context == context }"@en ;
             rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
             rdfs:label "mission plan"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "MissionPlan"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A mission plan is a collection of tasks, together with any required precedence relations among them, to be carried out in order to satisfy the mission within the given extended system and context."@en .


###  http://w3id.org/coresense/cso#MissionSpecification
:MissionSpecification rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty :goals ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :Goal
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :successCriteria ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :MissionSuccessCriterion
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :context ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :Context
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :extendedSystem ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :ExtendedSystem
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :mission ;
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :Mission
                                      ] ;
                      <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                      :sysmlKind "item def" ;
                      :sysmlName "CSBase::MissionSpecification" ;
                      rdfs:comment "SysML constraint GoalsConsistentWithMission: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == extendedSystem }"@en ;
                      rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                      rdfs:label "mission specification"@en ;
                      <http://www.w3.org/2004/02/skos/core#altLabel> "MissionSpecification"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A mission specification is the set of specific goals refining a given mission, together with the mission success criteria (expressed as metrics and their satisfaction conditions) that enable assessment of mission success."@en .


###  http://w3id.org/coresense/cso#MissionSuccessCriterion
:MissionSuccessCriterion rdf:type owl:Class ;
                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty :metric ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :Metric
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :satisfactionCondition ;
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ;
                         <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                         :sysmlKind "item def" ;
                         :sysmlName "CSBase::MissionSuccessCriterion" ;
                         rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                         rdfs:label "mission success criterion"@en ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "MissionSuccessCriterion"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A mission success criterion pairs a metric with a satisfaction condition in a given context."@en .


###  http://w3id.org/coresense/cso#Model
:Model rdf:type owl:Class ;
       rdfs:subClassOf :Entity ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :modelets ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Modelet
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :modeltype ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :ModelType
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :referent ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Entity
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :usedBy ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Entity
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isComposable ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:boolean
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isExertableOnItsOwn ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:boolean
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :isActionable ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:boolean
                       ] ;
       <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
       :sysmlKind "abstract part def" ;
       :sysmlName "CSCore::Model" ;
       rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
       rdfs:label "model"@en ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "Model"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "A model is an entity that represents another entity (its referent)."@en .


###  http://w3id.org/coresense/cso#ModelMetadata
:ModelMetadata rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :stakeholders ;
                                 owl:allValuesFrom :Stakeholder
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :epistemicState ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :EpistemicState
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :metamodelingLevel ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :OMG_MOF
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :performanceConstraint ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :PerformanceConstraint
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :provenance ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Provenance
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :scalabilityConstraint ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :ScalabilityConstraint
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :assumptions ;
                                 owl:allValuesFrom xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :id ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :name ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :abstractionLevel ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :description ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :intendedUse ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :modelClass ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :modelFormalism ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :modelledPhenomenon ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ;
               :sysmlKind "metadata def" ;
               :sysmlName "CSCore::ModelMetadata" ;
               rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
               rdfs:label "model metadata"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "ModelMetadata"@en .


###  http://w3id.org/coresense/cso#ModelType
:ModelType rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:oneOf ( :ModelType_analyticalModel
                                             :ModelType_descriptiveModel
                                             :ModelType_hybridModel
                                             :ModelType_metaModel
                                             :ModelType_physicalModel
                                           )
                               ] ;
           rdfs:subClassOf owl:Thing ;
           :sysmlKind "enum def" ;
           :sysmlName "CSCore::ModelType" ;
           rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
           rdfs:label "model type"@en ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "ModelType"@en .


###  http://w3id.org/coresense/cso#Modelet
:Modelet rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :aspect ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :ModeletAspect
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :referent ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Entity
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isComposable ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:boolean
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isExertableOnItsOwn ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:boolean
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :aspectDescription ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:string
                         ] ;
         <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
         :sysmlKind "abstract part def" ;
         :sysmlName "CSCore::Modelet" ;
         rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
         rdfs:label "modelet"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Modelet"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A modelet is a model fragment that represents a specific aspect of a referent system or entity."@en .


###  http://w3id.org/coresense/cso#ModeletAspect
:ModeletAspect rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( :ModeletAspect_behavior
                                                 :ModeletAspect_capability
                                                 :ModeletAspect_parameter
                                                 :ModeletAspect_performance
                                                 :ModeletAspect_property
                                                 :ModeletAspect_states
                                                 :ModeletAspect_structure
                                               )
                                   ] ;
               rdfs:subClassOf owl:Thing ;
               :sysmlKind "enum def" ;
               :sysmlName "CSCore::ModeletAspect" ;
               rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
               rdfs:label "modelet aspect"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "ModeletAspect"@en .


###  http://w3id.org/coresense/cso#ModeletEnginePair
:ModeletEnginePair rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :engine ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Engine
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :modelet ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Modelet
                                   ] ;
                   <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                   :sysmlKind "item def" ;
                   :sysmlName "CSCore::ModeletEnginePair" ;
                   rdfs:comment "SysML constraint EngineSupportsModelet: engine.modelets->SequenceFunctions::includes(modelet)"@en ;
                   rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                   rdfs:label "modelet engine pair"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "ModeletEnginePair"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Pairing of a modelet with an engine that can exert it."@en .


###  http://w3id.org/coresense/cso#OMG_MOF
:OMG_MOF rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Class ;
                               owl:oneOf ( :OMG_MOF_M0
                                           :OMG_MOF_M1
                                           :OMG_MOF_M2
                                           :OMG_MOF_M3
                                         )
                             ] ;
         rdfs:subClassOf owl:Thing ;
         :sysmlKind "enum def" ;
         :sysmlName "CSCore::OMG_MOF" ;
         rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
         rdfs:label "omg mof"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "OMG_MOF"@en .


###  http://w3id.org/coresense/cso#PerformanceConstraint
:PerformanceConstraint rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :actualResponseTime ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:decimal
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :maxResponseTime ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:decimal
                                       ] ;
                       <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                       :sysmlKind "constraint def" ;
                       :sysmlName "CSCore::PerformanceConstraint" ;
                       rdfs:comment "SysML constraint ResponseTime: actualResponseTime <= maxResponseTime"@en ;
                       rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                       rdfs:label "performance constraint"@en ;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "PerformanceConstraint"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Performance constraint on model usage (e.g., for run-time use)."@en .


###  http://w3id.org/coresense/cso#PerformanceMeasure
:PerformanceMeasure rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :goals ;
                                      owl:allValuesFrom :Goal
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :context ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Context
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :exhibitedBehavior ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :ExhibitedBehavior
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :extendedSystem ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :ExtendedSystem
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :object ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :Entity
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :perfType ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :PerformanceMeasureType
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :value ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:decimal
                                    ] ;
                    <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                    :sysmlKind "item def" ;
                    :sysmlName "CSBase::PerformanceMeasure" ;
                    rdfs:comment "SysML constraint BehaviorOfTargetSystem: exhibitedBehavior.system == context.extendedSystem.targetSystem"@en ,
                                 "SysML constraint GoalsOfSameExtendedSystem: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == context.extendedSystem }"@en ,
                                 "SysML constraint ObjectWithinExtendedSystem: object == extendedSystem.targetSystem or extendedSystem.targetSystem.components->SequenceFunctions::includes(object) or extendedSystem.environmentEntities->SequenceFunctions::includes(object)"@en ;
                    rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                    rdfs:label "performance measure"@en ;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "PerformanceMeasure"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Performance is a measure of how effectively the exhibited behavior of a system (or one of its components) contributes to fulfilling its goals when executing tasks within a given context."@en .


###  http://w3id.org/coresense/cso#PerformanceMeasureType
:PerformanceMeasureType rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( :PerformanceMeasureType_MOE
                                                          :PerformanceMeasureType_MOP
                                                          :PerformanceMeasureType_TPM
                                                        )
                                            ] ;
                        rdfs:subClassOf owl:Thing ;
                        :sysmlKind "enum def" ;
                        :sysmlName "CSBase::PerformanceMeasureType" ;
                        rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                        rdfs:label "performance measure type"@en ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "PerformanceMeasureType"@en .


###  http://w3id.org/coresense/cso#Phenomenon
:Phenomenon rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :exhibitedBy ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Entity
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :context ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Context
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :extendedSystem ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :ExtendedSystem
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :description ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ;
            <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
            :sysmlKind "item def" ;
            :sysmlName "CSCore::Phenomenon" ;
            rdfs:comment "SysML constraint ContextMatchesExtendedSystem: context.extendedSystem == extendedSystem"@en ,
                         "SysML constraint ExhibitedByWithinExtendedSystem: exhibitedBy->ControlFunctions::forAll { in b : Entity; b == extendedSystem or b == extendedSystem.targetSystem or extendedSystem.targetSystem.components->SequenceFunctions::includes(b) or extendedSystem.environmentEntities->SequenceFunctions::includes(b) }"@en ;
            rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
            rdfs:label "phenomenon"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Phenomenon"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A phenomenon is any distinguishable aspect or behavior of an extended system, or of one of its parts, within a given context."@en .


###  http://w3id.org/coresense/cso#Policy
:Policy rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :candidateActions ;
                          owl:allValuesFrom :Action
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :context ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Context
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :extendedSystem ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :ExtendedSystem
                        ] ;
        <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
        :sysmlKind "item def" ;
        :sysmlName "CSActionControl::Policy" ;
        rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
        rdfs:label "policy"@en ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "Policy"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "A policy is a rule or strategy that, for a given action trigger and a given context of an extended system, determines a set of candidate actions that are admissible responses to that trigger in that context."@en .


###  http://w3id.org/coresense/cso#PotentialBehavior
:PotentialBehavior rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :trajectories ;
                                     owl:allValuesFrom :SystemTrajectory
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :system ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :System
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :timeInterval ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :TimeInterval
                                   ] ;
                   <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                   :sysmlKind "item def" ;
                   :sysmlName "CSBase::PotentialBehavior" ;
                   rdfs:comment "SysML constraint ConsistentWithSystem: trajectories->ControlFunctions::forAll { in tr : SystemTrajectory; tr.system == system }"@en ,
                                "SysML constraint TrajectoriesAtSameInterval: trajectories->ControlFunctions::forAll { in tr : SystemTrajectory; tr.timeInterval.initialTime == timeInterval.initialTime and tr.timeInterval.finalTime == timeInterval.finalTime }"@en ;
                   rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                   rdfs:label "potential behavior"@en ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "PotentialBehavior"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The potential behavior of a system over a time interval is the set of all trajectories the system may follow over that interval."@en .


###  http://w3id.org/coresense/cso#Projection
:Projection rdf:type owl:Class ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty :context ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Context
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :extendedSystem ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :ExtendedSystem
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :potentialBehavior ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :PotentialBehavior
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :timeInterval ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :TimeInterval
                            ] ;
            <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
            :sysmlKind "item def" ;
            :sysmlName "CSCore::Projection" ;
            rdfs:comment "SysML constraint PotentialBehaviorIsOfThisExtendedSystem: potentialBehavior.system == extendedSystem"@en ;
            rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
            rdfs:label "projection"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Projection"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Projection is a representation that maps a given situation of an extended system in a given context, into a representation in a chosen space, over a specified projection domain."@en .


###  http://w3id.org/coresense/cso#Provenance
:Provenance rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:oneOf ( :Provenance_Derived
                                              :Provenance_Historical
                                              :Provenance_Original
                                              :Provenance_Versioned
                                            )
                                ] ;
            rdfs:subClassOf owl:Thing ;
            :sysmlKind "enum def" ;
            :sysmlName "CSCore::Provenance" ;
            rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
            rdfs:label "provenance"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Provenance"@en .


###  http://w3id.org/coresense/cso#Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :adverseEvent ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :AdverseOccurrence
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :context ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Context
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :likelihood ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onDataRange xsd:decimal
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :severity ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onDataRange xsd:decimal
                      ] ;
      <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
      :sysmlKind "item def" ;
      :sysmlName "CSBase::Risk" ;
      rdfs:comment "SysML constraint LikelihoodBounds: 0.0 <= likelihood and likelihood <= 1.0"@en ;
      rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
      rdfs:label "risk"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "Risk"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A risk is a measure of the potential for an adverse event to negatively affect an entity, system, or extended system within a given context."@en .


###  http://w3id.org/coresense/cso#Role
:Role rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :playedBy ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Entity
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :context ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Context
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :timeInterval ;
                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :TimeInterval
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :responsibilities ;
                        owl:allValuesFrom xsd:string
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :roleConstraints ;
                        owl:allValuesFrom xsd:string
                      ] ;
      <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
      :sysmlKind "item def" ;
      :sysmlName "CSBase::Role" ;
      rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
      rdfs:label "role"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "Role"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A role is a context- and time-dependent designation, with associated responsibilities and constraints, that an entity may assume in order to contribute to the achievement or maintenance of a goal."@en .


###  http://w3id.org/coresense/cso#ScalabilityConstraint
:ScalabilityConstraint rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :maxUsers ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :numberOfUsers ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ;
                       <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                       :sysmlKind "constraint def" ;
                       :sysmlName "CSCore::ScalabilityConstraint" ;
                       rdfs:comment "SysML constraint Scalability: numberOfUsers <= maxUsers"@en ;
                       rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                       rdfs:label "scalability constraint"@en ;
                       <http://www.w3.org/2004/02/skos/core#altLabel> "ScalabilityConstraint"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Scalability constraint on model usage (e.g., number of concurrent users)."@en .


###  http://w3id.org/coresense/cso#SelfModel
:SelfModel rdf:type owl:Class ;
           rdfs:subClassOf :Model ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :referent ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Agent
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :usedBy ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Agent
                           ] ;
           <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
           :sysmlKind "abstract part def" ;
           :sysmlName "CSCore::SelfModel" ;
           rdfs:comment "SysML constraint SelfEquality: referent == usedBy"@en ;
           rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
           rdfs:label "self model"@en ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "SelfModel"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "A SelfModel is a Model whose referent is the owning system itself."@en .


###  http://w3id.org/coresense/cso#Sense
:Sense rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :extendedSystem ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :ExtendedSystem
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :rawData ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Data
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :target ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Entity
                       ] ;
       <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
       :sysmlKind "action def" ;
       :sysmlName "CSBase::Sense" ;
       rdfs:comment "SysML constraint OutputConsistent: rawData.extendedSystem == extendedSystem"@en ,
                    "SysML constraint TargetWithinExtendedSystem: target == extendedSystem.targetSystem or extendedSystem.targetSystem.components->SequenceFunctions::includes(target) or extendedSystem.environmentEntities->SequenceFunctions::includes(target)"@en ;
       rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
       rdfs:label "sense"@en ;
       <http://www.w3.org/2004/02/skos/core#altLabel> "Sense"@en ;
       <http://www.w3.org/2004/02/skos/core#definition> "Acquire raw sensor data about the phenomenon being observed in the extended system."@en .


###  http://w3id.org/coresense/cso#Sensor
:Sensor rdf:type owl:Class ;
        rdfs:subClassOf :Entity ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :observes ;
                          owl:allValuesFrom :Entity
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :senses ;
                          owl:allValuesFrom :Sense
                        ] ;
        <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
        :sysmlKind "part def" ;
        :sysmlName "CSBase::Sensor" ;
        rdfs:comment "SysML constraint SenseTargetsObservableEntities: senses->ControlFunctions::forAll { in s : Sense; observes->SequenceFunctions::includes(s.target) }"@en ;
        rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
        rdfs:label "sensor"@en ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "Sensor"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "A sensor is an entity that acquires raw data about phenomena, properties, states, or attributes of another entity being observed in the extended system."@en .


###  http://w3id.org/coresense/cso#Situation
:Situation rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :holdsOver ;
                             owl:allValuesFrom :SystemState
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :situationContext ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Context
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :conditions ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ;
           <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
           :sysmlKind "constraint def" ;
           :sysmlName "CSBase::Situation" ;
           rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
           rdfs:label "situation"@en ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "Situation"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "A situation is a context-dependent condition on the state or exhibited behavior of an extended system, expressed in terms of a finite subset of relevant attribute values and relation instances."@en .


###  http://w3id.org/coresense/cso#Stakeholder
:Stakeholder rdf:type owl:Class ;
             rdfs:subClassOf :Entity ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :desires ;
                               owl:allValuesFrom :Desire
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :interests ;
                               owl:allValuesFrom :Interest
                             ] ;
             <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
             :sysmlKind "item def" ;
             :sysmlName "CSBase::Stakeholder" ;
             rdfs:comment "SysML constraint OwnsDesires: desires->ControlFunctions::forAll { in d : Desire; d.who == self }"@en ,
                          "SysML constraint OwnsInterests: interests->ControlFunctions::forAll { in c : Interest; c.who == self }"@en ;
             rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
             rdfs:label "stakeholder"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Stakeholder"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A stakeholder is an entity for whom a system S is relevant because the behavior or outcomes of S can affect the achievement of its own goals."@en .


###  http://w3id.org/coresense/cso#StakeholderValue
:StakeholderValue rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :context ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Context
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :sh ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Stakeholder
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :benefit ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:decimal
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :cost ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:decimal
                                  ] ;
                  <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                  :sysmlKind "item def" ;
                  :sysmlName "CSBase::StakeholderValue" ;
                  rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                  rdfs:label "stakeholder value"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "StakeholderValue"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Stakeholder value is the amount of benefit at a cost provided to stakeholders within a given context."@en .


###  http://w3id.org/coresense/cso#SuperSystem
:SuperSystem rdf:type owl:Class ;
             rdfs:subClassOf :System ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :components ;
                               owl:allValuesFrom :System
                             ] ;
             <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
             :sysmlKind "part def" ;
             :sysmlName "CSBase::SuperSystem" ;
             rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
             rdfs:label "super system"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "SuperSystem"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A super system is a system whose components are, themselves, systems."@en .


###  http://w3id.org/coresense/cso#System
:System rdf:type owl:Class ;
        rdfs:subClassOf :Entity ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :components ;
                          owl:allValuesFrom :Entity
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :relations ;
                          owl:allValuesFrom :BinaryRelation
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isAdaptable ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:boolean
                        ] ;
        <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
        :sysmlKind "part def" ;
        :sysmlName "CSBase::System" ;
        rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
        rdfs:label "system"@en ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "System"@en ;
        <http://www.w3.org/2004/02/skos/core#definition> "A system is an entity represented by a tuple (C, R), where C is a set of components and R is the set of binary relations between them."@en .


###  http://w3id.org/coresense/cso#SystemOfInterest
:SystemOfInterest rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :csstakeholder ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Stakeholder
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :extendedSystem ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :ExtendedSystem
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :system ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :System
                                  ] ;
                  <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                  :sysmlKind "item def" ;
                  :sysmlName "CSBase::SystemOfInterest" ;
                  rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                  rdfs:label "system of interest"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "SystemOfInterest"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "For a given stakeholder, the system of interest is the part of an extended system that constitutes the focus of engineering activities."@en .


###  http://w3id.org/coresense/cso#SystemState
:SystemState rdf:type owl:Class ;
             rdfs:subClassOf :EntityState ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :componentStates ;
                               owl:allValuesFrom :EntityState
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :relationStates ;
                               owl:allValuesFrom :BinaryRelationState
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :entity ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :System
                             ] ;
             <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
             :sysmlKind "occurrence def" ;
             :sysmlName "CSBase::SystemState" ;
             rdfs:comment "SysML constraint AllComponentsHaveState: entity.components->ControlFunctions::forAll { in c : Entity; componentStates->ControlFunctions::exists { in es : EntityState; es.entity == c } }"@en ,
                          "SysML constraint AllRelationsHaveState: entity.relations->ControlFunctions::forAll { in r : BinaryRelation; relationStates->ControlFunctions::exists { in rs : BinaryRelationState; rs.relation == r } }"@en ,
                          "SysML constraint AtMostOneStatePerComponent: componentStates->ControlFunctions::forAll { in es1 : EntityState; componentStates->ControlFunctions::forAll { in es2 : EntityState; es1 != es2 implies es1.entity != es2.entity } }"@en ,
                          "SysML constraint AtMostOneStatePerRelation: relationStates->ControlFunctions::forAll { in rs1 : BinaryRelationState; relationStates->ControlFunctions::forAll { in rs2 : BinaryRelationState; rs1 != rs2 implies rs1.relation != rs2.relation } }"@en ,
                          "SysML constraint ComponentBelongToSystem: componentStates->ControlFunctions::forAll { in es : EntityState; entity.components->SequenceFunctions::includes(es.entity) }"@en ,
                          "SysML constraint ComponentStatesAtSystemTime: componentStates->ControlFunctions::forAll { in es : EntityState; es.timeInstant == timeInstant }"@en ,
                          "SysML constraint RelationStatesAtSystemTime: relationStates->ControlFunctions::forAll { in rs : BinaryRelationState; rs.timeInstant == timeInstant }"@en ,
                          "SysML constraint RelationsBelongToSystem: relationStates->ControlFunctions::forAll { in rs : BinaryRelationState; entity.relations->SequenceFunctions::includes(rs.relation) }"@en ;
             rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
             rdfs:label "system state"@en ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "SystemState"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "The state of a system at a time instant is the complete set of attribute values describing the current condition of its components and their relations."@en .


###  http://w3id.org/coresense/cso#SystemTrajectory
:SystemTrajectory rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :states ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :SystemState
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :system ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :System
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :timeInterval ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :TimeInterval
                                  ] ;
                  <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
                  :sysmlKind "occurrence def" ;
                  :sysmlName "CSBase::SystemTrajectory" ;
                  rdfs:comment "SysML constraint ConsistentWithSystem: states->ControlFunctions::forAll { in st : SystemState; st.entity == system }"@en ,
                               "SysML constraint StateTimesUseIntervalTimeScale: states->ControlFunctions::forAll { in st : SystemState; st.timeInstant.mRef == timeInterval.initialTime.mRef }"@en ,
                               "SysML constraint StateTimesWithinInterval: states->ControlFunctions::forAll { in st : SystemState; timeInterval.initialTime <= st.timeInstant and st.timeInstant <= timeInterval.finalTime }"@en ,
                               "SysML constraint StrictlyIncreasingTime: SequenceFunctions::size(states) == 1 or (1..(SequenceFunctions::size(states) - 1))->ControlFunctions::forAll { in i : Natural; states#(i).timeInstant < states#(i + 1).timeInstant }"@en ;
                  rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                  rdfs:label "system trajectory"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "SystemTrajectory"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A trajectory is a time-ordered sequence of states representing one possible evolution of the system over a time interval."@en .


###  http://w3id.org/coresense/cso#Task
:Task rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :goals ;
                        owl:allValuesFrom :Goal
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :plannedActions ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Action
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :context ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Context
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :extendedSystem ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :ExtendedSystem
                      ] ;
      <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
      :sysmlKind "action def" ;
      :sysmlName "CSBase::Task" ;
      rdfs:comment "SysML constraint GoalsOfSameExtendedSystem: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == extendedSystem }"@en ;
      rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
      rdfs:label "task"@en ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "Task"@en ;
      <http://www.w3.org/2004/02/skos/core#definition> "A task is a set of planned actions, executed by one or more agents, that is intended to contribute to the achievement of one or more goals within a given context."@en .


###  http://w3id.org/coresense/cso#TaskRequiresSystemCapability
:TaskRequiresSystemCapability rdf:type owl:Class ;
                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                owl:onProperty :capability ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass :Capability
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty :task ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass :Task
                                              ] ;
                              :sysmlKind "connection def" ;
                              :sysmlName "CSBase::TaskRequiresSystemCapability" ;
                              rdfs:comment "SysML constraint SameSystem: capability.system == task.extendedSystem.targetSystem"@en ;
                              rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                              rdfs:label "task requires system capability"@en ;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "TaskRequiresSystemCapability"@en .


###  http://w3id.org/coresense/cso#TimeInterval
:TimeInterval rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :finalTime ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :initialTime ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ;
              :sysmlKind "attribute def" ;
              :sysmlName "CSBase::TimeInterval" ;
              rdfs:comment "SysML constraint SameTimeScale: initialTime.mRef == finalTime.mRef"@en ,
                           "SysML constraint ValidInterval: initialTime < finalTime"@en ;
              rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
              rdfs:label "time interval"@en ;
              <http://www.w3.org/2004/02/skos/core#altLabel> "TimeInterval"@en .


###  http://w3id.org/coresense/cso#Trigger
:Trigger rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :condition ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :TriggerCondition
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :context ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Context
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :extendedSystem ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :ExtendedSystem
                         ] ;
         <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
         :sysmlKind "abstract item def" ;
         :sysmlName "CSActionControl::Trigger" ;
         rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
         rdfs:label "trigger"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Trigger"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "An action trigger is a condition on the state and/or exhibited behavior of an extended system, identified within a given context, whose satisfaction indicates the need to initiate the execution of one or more actions to contribute to the achievement or maintenance of one or more goals."@en .


###  http://w3id.org/coresense/cso#TriggerCondition
:TriggerCondition rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :extendedSystem ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :ExtendedSystem
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :triggerContext ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :Context
                                  ] ;
                  :sysmlKind "abstract constraint def" ;
                  :sysmlName "CSActionControl::TriggerCondition" ;
                  rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                  rdfs:label "trigger condition"@en ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "TriggerCondition"@en .


###  http://w3id.org/coresense/cso#Understanding
:Understanding rdf:type owl:Class ;
               rdfs:subClassOf :CognitiveCapability ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :usefulModels ;
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Model
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :context ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Context
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :understoodPhenomenon ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Phenomenon
                               ] ;
               <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
               :sysmlKind "item def" ;
               :sysmlName "CSCore::Understanding" ;
               rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
               rdfs:label "understanding"@en ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Understanding"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Understanding is the capability of an entity to construct and use models of a phenomenon or system in order to make reliable inferences about it."@en .


###  http://w3id.org/coresense/cso#WorldModel
:WorldModel rdf:type owl:Class ;
            rdfs:subClassOf :Model ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :referent ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :ExtendedSystem
                            ] ;
            <http://purl.org/dc/terms/source> <https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf> ;
            :sysmlKind "abstract part def" ;
            :sysmlName "CSCore::WorldModel" ;
            rdfs:comment "SysML constraint UsedByInTargetOrEnvironment: referent.targetSystem.components->SequenceFunctions::includes(usedBy) or referent.environmentEntities->SequenceFunctions::includes(usedBy)"@en ;
            rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
            rdfs:label "world model"@en ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "WorldModel"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A WorldModel is a Model whose referent is the ExtendedSystem being operated in."@en .



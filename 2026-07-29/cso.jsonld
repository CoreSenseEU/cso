}, {
  "@id" : "http://w3id.org/coresense/cso#PerformanceMeasure",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "item def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::PerformanceMeasure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint BehaviorOfTargetSystem: exhibitedBehavior.system == context.extendedSystem.targetSystem"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint GoalsOfSameExtendedSystem: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == context.extendedSystem }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint ObjectWithinExtendedSystem: object == extendedSystem.targetSystem or extendedSystem.targetSystem.components->SequenceFunctions::includes(object) or extendedSystem.environmentEntities->SequenceFunctions::includes(object)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "performance measure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid329"
  }, {
    "@id" : "_:genid330"
  }, {
    "@id" : "_:genid331"
  }, {
    "@id" : "_:genid332"
  }, {
    "@id" : "_:genid333"
  }, {
    "@id" : "_:genid334"
  }, {
    "@id" : "_:genid335"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "PerformanceMeasure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Performance is a measure of how effectively the exhibited behavior of a system (or one of its components) contributes to fulfilling its goals when executing tasks within a given context."
  } ]

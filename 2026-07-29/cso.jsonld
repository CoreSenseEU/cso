  }, {
    "@id" : "_:genid230"
  }, {
    "@id" : "_:genid231"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "ExhibitedBehavior"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The exhibited behavior of a system over an observational interval is the trajectory followed by the system during that interval."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#ExtendedSystem",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "part def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::ExtendedSystem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint ComponentsAreExactlyTargetAndEnvironment: components->ControlFunctions::forAll { in c : Entity; c == targetSystem or environmentEntities->SequenceFunctions::includes(c) }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint EnvironmentEntitySetMatches: environment.entities->ControlFunctions::forAll { in e : Entity; environmentEntities->SequenceFunctions::includes(e) } and environmentEntities->ControlFunctions::forAll { in e : Entity; environment.entities->SequenceFunctions::includes(e) }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint EnvironmentMatchesTargetSystem: environment.system == targetSystem"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint OnlySERelations: systemEnvironmentRelations->ControlFunctions::forAll { in r : BinaryRelation; (r.source == targetSystem and environmentEntities->SequenceFunctions::includes(r.target)) or (r.target == targetSystem and environmentEntities->SequenceFunctions::includes(r.source)) }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint RelationsAreExactlySERelations: relations->ControlFunctions::forAll { in r : BinaryRelation; systemEnvironmentRelations->SequenceFunctions::includes(r) }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extended system"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/coresense/cso#System"
  }, {
    "@id" : "_:genid232"
  }, {
    "@id" : "_:genid233"
  }, {
    "@id" : "_:genid234"
  }, {
    "@id" : "_:genid235"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "ExtendedSystem"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An extended system is composed of a target system together with its selected environment and the relations between both of them."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Feature",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "item def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSCore::Feature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "feature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid236"
  }, {
    "@id" : "_:genid237"
  }, {
    "@id" : "_:genid238"
  }, {
    "@id" : "_:genid239"
  }, {
    "@id" : "_:genid240"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Feature"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A feature is a derived piece of information that encodes some characteristic of an entity, system, phenomenon, or context, obtained from observations or sensor data and used as input to functions or modelets."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Function",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "item def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::Function"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "function"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid241"
  }, {
    "@id" : "_:genid242"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Function"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A function is a transformation that maps specific inputs to outputs."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Functionality",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "item def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::Functionality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint ExpectedPerformanceConsistent: expectedPerformance->ControlFunctions::forAll { in pm : PerformanceMeasure; pm.context.extendedSystem == context.extendedSystem and pm.object == object }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint GoalsOfSameExtendedSystem: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == context.extendedSystem }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint ObjectWithinExtendedSystem: object == context.extendedSystem or context.extendedSystem.targetSystem.components->SequenceFunctions::includes(object)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "functionality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid243"
  }, {
    "@id" : "_:genid244"
  }, {
    "@id" : "_:genid245"
  }, {
    "@id" : "_:genid246"
  }, {
    "@id" : "_:genid247"
  }, {
    "@id" : "_:genid248"
  }, {
    "@id" : "_:genid249"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Functionality"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A functionality is an instantiation of a capability with some expected performance that is intended to satisfy one or more goals within a given context."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Goal",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "item def"

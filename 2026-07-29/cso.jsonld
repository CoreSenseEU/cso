    "@language" : "en",
    "@value" : "Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An agent is an entity capable of executing or commanding actions."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Awareness",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],

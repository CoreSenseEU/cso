  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint GoalsConsistentWithMission: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == extendedSystem }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"

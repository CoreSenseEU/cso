  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint ContextMatchesExtendedSystem: context.extendedSystem == extendedSystem"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint ExhibitedByWithinExtendedSystem: exhibitedBy->ControlFunctions::forAll { in b : Entity; b == extendedSystem or b == extendedSystem.targetSystem or extendedSystem.targetSystem.components->SequenceFunctions::includes(b) or extendedSystem.environmentEntities->SequenceFunctions::includes(b) }"
  } ],

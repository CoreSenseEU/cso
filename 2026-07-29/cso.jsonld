  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Situation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A situation is a context-dependent condition on the state or exhibited behavior of an extended system, expressed in terms of a finite subset of relevant attribute values and relation instances."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Stakeholder",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "item def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::Stakeholder"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint OwnsDesires: desires->ControlFunctions::forAll { in d : Desire; d.who == self }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint OwnsInterests: interests->ControlFunctions::forAll { in c : Interest; c.who == self }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "stakeholder"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/coresense/cso#Entity"
  }, {
    "@id" : "_:genid380"
  }, {
    "@id" : "_:genid381"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Stakeholder"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A stakeholder is an entity for whom a system S is relevant because the behavior or outcomes of S can affect the achievement of its own goals."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#StakeholderValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "item def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::StakeholderValue"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "stakeholder value"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid382"
  }, {
    "@id" : "_:genid383"
  }, {
    "@id" : "_:genid384"
  }, {
    "@id" : "_:genid385"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "StakeholderValue"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Stakeholder value is the amount of benefit at a cost provided to stakeholders within a given context."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#SuperSystem",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "part def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::SuperSystem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "super system"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/coresense/cso#System"
  }, {
    "@id" : "_:genid386"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "SuperSystem"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A super system is a system whose components are, themselves, systems."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#System",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "part def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::System"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "system"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/coresense/cso#Entity"
  }, {
    "@id" : "_:genid387"
  }, {
    "@id" : "_:genid388"
  }, {
    "@id" : "_:genid389"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "System"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A system is an entity represented by a tuple (C, R), where C is a set of components and R is the set of binary relations between them."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#SystemOfInterest",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "item def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::SystemOfInterest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "system of interest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid390"
  }, {
    "@id" : "_:genid391"
  }, {
    "@id" : "_:genid392"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "SystemOfInterest"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "For a given stakeholder, the system of interest is the part of an extended system that constitutes the focus of engineering activities."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#SystemState",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "occurrence def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::SystemState"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint AllComponentsHaveState: entity.components->ControlFunctions::forAll { in c : Entity; componentStates->ControlFunctions::exists { in es : EntityState; es.entity == c } }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint AllRelationsHaveState: entity.relations->ControlFunctions::forAll { in r : BinaryRelation; relationStates->ControlFunctions::exists { in rs : BinaryRelationState; rs.relation == r } }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint AtMostOneStatePerComponent: componentStates->ControlFunctions::forAll { in es1 : EntityState; componentStates->ControlFunctions::forAll { in es2 : EntityState; es1 != es2 implies es1.entity != es2.entity } }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint AtMostOneStatePerRelation: relationStates->ControlFunctions::forAll { in rs1 : BinaryRelationState; relationStates->ControlFunctions::forAll { in rs2 : BinaryRelationState; rs1 != rs2 implies rs1.relation != rs2.relation } }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint ComponentBelongToSystem: componentStates->ControlFunctions::forAll { in es : EntityState; entity.components->SequenceFunctions::includes(es.entity) }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint ComponentStatesAtSystemTime: componentStates->ControlFunctions::forAll { in es : EntityState; es.timeInstant == timeInstant }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint RelationStatesAtSystemTime: relationStates->ControlFunctions::forAll { in rs : BinaryRelationState; rs.timeInstant == timeInstant }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint RelationsBelongToSystem: relationStates->ControlFunctions::forAll { in rs : BinaryRelationState; entity.relations->SequenceFunctions::includes(rs.relation) }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "system state"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/coresense/cso#EntityState"
  }, {
    "@id" : "_:genid393"
  }, {
    "@id" : "_:genid394"
  }, {
    "@id" : "_:genid395"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "SystemState"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The state of a system at a time instant is the complete set of attribute values describing the current condition of its components and their relations."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#SystemTrajectory",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "occurrence def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::SystemTrajectory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint ConsistentWithSystem: states->ControlFunctions::forAll { in st : SystemState; st.entity == system }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint StateTimesUseIntervalTimeScale: states->ControlFunctions::forAll { in st : SystemState; st.timeInstant.mRef == timeInterval.initialTime.mRef }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint StateTimesWithinInterval: states->ControlFunctions::forAll { in st : SystemState; timeInterval.initialTime <= st.timeInstant and st.timeInstant <= timeInterval.finalTime }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint StrictlyIncreasingTime: SequenceFunctions::size(states) == 1 or (1..(SequenceFunctions::size(states) - 1))->ControlFunctions::forAll { in i : Natural; states#(i).timeInstant < states#(i + 1).timeInstant }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "system trajectory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid396"
  }, {
    "@id" : "_:genid397"
  }, {
    "@id" : "_:genid398"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "SystemTrajectory"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A trajectory is a time-ordered sequence of states representing one possible evolution of the system over a time interval."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Task",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "action def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::Task"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint GoalsOfSameExtendedSystem: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == extendedSystem }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "task"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid399"
  }, {
    "@id" : "_:genid400"
  }, {
    "@id" : "_:genid401"
  }, {
    "@id" : "_:genid402"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Task"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A task is a set of planned actions, executed by one or more agents, that is intended to contribute to the achievement of one or more goals within a given context."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#TaskRequiresSystemCapability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "connection def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::TaskRequiresSystemCapability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint SameSystem: capability.system == task.extendedSystem.targetSystem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "task requires system capability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid403"
  }, {
    "@id" : "_:genid404"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "TaskRequiresSystemCapability"
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#TimeInterval",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "attribute def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::TimeInterval"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint SameTimeScale: initialTime.mRef == finalTime.mRef"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint ValidInterval: initialTime < finalTime"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "time interval"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid405"
  }, {
    "@id" : "_:genid406"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "TimeInterval"
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Trigger",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {

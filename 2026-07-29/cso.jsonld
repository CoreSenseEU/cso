    "@language" : "en",
    "@value" : "Sense"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Acquire raw sensor data about the phenomenon being observed in the extended system."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Sensor",

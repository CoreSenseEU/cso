  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3id.org/coresense/cso#Entity"
  }, {
    "@id" : "_:genid375"
  }, {
    "@id" : "_:genid376"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Sensor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A sensor is an entity that acquires raw data about phenomena, properties, states, or attributes of another entity being observed in the extended system."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Situation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {

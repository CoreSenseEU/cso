    "@language" : "en",
    "@value" : "A policy is a rule or strategy that, for a given action trigger and a given context of an extended system, determines a set of candidate actions that are admissible responses to that trigger in that context."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#PotentialBehavior",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],

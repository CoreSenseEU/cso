    "@value" : "CSBase::MissionPlan"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint MissionContextMatchesPlanContext: mission.context == context"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint TasksUseSameContext: tasks->ControlFunctions::forAll { in t : Task; t.context == context }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "mission plan"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid267"
  }, {
    "@id" : "_:genid268"
  }, {
    "@id" : "_:genid269"
  }, {
    "@id" : "_:genid270"
  }, {
    "@id" : "_:genid271"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "MissionPlan"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A mission plan is a collection of tasks, together with any required precedence relations among them, to be carried out in order to satisfy the mission within the given extended system and context."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#MissionSpecification",

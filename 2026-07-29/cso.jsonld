  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::Sensor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint SenseTargetsObservableEntities: senses->ControlFunctions::forAll { in s : Sense; observes->SequenceFunctions::includes(s.target) }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",

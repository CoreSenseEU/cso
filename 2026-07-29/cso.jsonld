  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Exert"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Exertion is the process of executing one or more modelets to given inputs in order to derive results about their referent."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#ExhibitedBehavior",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "item def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {

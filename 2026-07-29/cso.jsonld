    "@value" : "CSBase::Goal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint DesiredStatesAreOfThisExtendedSystem: desiredStates->ControlFunctions::forAll { in st : SystemState; st.entity == extendedSystem }"
  } ],

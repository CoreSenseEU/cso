    "@value" : "CSCore::Awareness"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint SensingHappensDuringAwareness: updatingSenses->ControlFunctions::forAll { in sn : Sense; self.timeEnclosedOccurrences->SequenceFunctions::includes(sn) }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint UnderstandingOfSamePhenomenon: maintainedUnderstanding.understoodPhenomenon == awarePhenomenon"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "awareness"

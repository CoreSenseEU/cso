  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint HasAtLeastOneActionRole: SequenceFunctions::size(executes) > 0 or SequenceFunctions::size(commands) > 0"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {

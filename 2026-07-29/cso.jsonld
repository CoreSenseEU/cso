  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint ExertionUseTheseModelets: exerts->ControlFunctions::forAll { in x : Exert; x.modelets->ControlFunctions::forAll { in m : Modelet; modelets->SequenceFunctions::includes(m) } }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint ExertionUseThisEngine: exerts->ControlFunctions::forAll { in x : Exert; x.engine == self }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],

    "@value" : "Actuator"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An actuator is a physical entity that, when provided with an input, produces a physical effect on the environment or the system (e.g., motion, force, or flow), thereby executing actions commanded by an agent."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#AdverseOccurrence",

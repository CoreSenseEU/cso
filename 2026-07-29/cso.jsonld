    "@language" : "en",
    "@value" : "mission specification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid272"
  }, {
    "@id" : "_:genid273"
  }, {
    "@id" : "_:genid274"
  }, {
    "@id" : "_:genid275"
  }, {
    "@id" : "_:genid276"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "MissionSpecification"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A mission specification is the set of specific goals refining a given mission, together with the mission success criteria (expressed as metrics and their satisfaction conditions) that enable assessment of mission success."
  } ]
}, {

  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Estimation is a cognitive function realized by a modelet-engine pair whose purpose is to infer unknown or uncertain quantities of a referent from available data and prior knowledge."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Evaluation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"

  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint ConsistentWithSystem: trajectories->ControlFunctions::forAll { in tr : SystemTrajectory; tr.system == system }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint TrajectoriesAtSameInterval: trajectories->ControlFunctions::forAll { in tr : SystemTrajectory; tr.timeInterval.initialTime == timeInterval.initialTime and tr.timeInterval.finalTime == timeInterval.finalTime }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {

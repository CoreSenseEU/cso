    "@value" : "item def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSCore::Evaluation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint GoalsMatchExtendedSystem: goals->ControlFunctions::forAll { in g : Goal; g.extendedSystem == extendedSystem }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint PerformanceUseSameContext: performance->ControlFunctions::forAll { in p : PerformanceMeasure; p.context == context }"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint RisksUseSameContext: risks->ControlFunctions::forAll { in r : Risk; r.context == context }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "evaluation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid216"
  }, {
    "@id" : "_:genid217"
  }, {
    "@id" : "_:genid218"
  }, {
    "@id" : "_:genid219"
  }, {
    "@id" : "_:genid220"
  }, {
    "@id" : "_:genid221"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Evaluation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Evaluation is an assessment of a projection with respect to a specific set of goals."
  } ]
}, {
  "@id" : "http://w3id.org/coresense/cso#Event",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://github.com/CoreSenseEU/ontology/blob/main/docs/CS-115_CS_Ontology.pdf"
  } ],
  "http://w3id.org/coresense/cso#sysmlKind" : [ {
    "@value" : "occurrence def"
  } ],
  "http://w3id.org/coresense/cso#sysmlName" : [ {
    "@value" : "CSBase::Event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "SysML constraint Instantaneous: startShot == endShot"
  }, {
    "@language" : "en",
    "@value" : "SysML constraint StatesOfThisExtendedSystem: priorState->ControlFunctions::forAll { in st : SystemState; st.entity == extendedSystem }"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://w3id.org/coresense/cso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid222"
  }, {
    "@id" : "_:genid223"
  }, {
    "@id" : "_:genid224"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Event"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An event is an occurrence that represents a change in an extended system."
  } ]
}, {

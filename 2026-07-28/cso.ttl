###  http://w3id.org/coresense/cso#hasRoleConstraint
:hasRoleConstraint rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Role ;
                   rdfs:range xsd:string ;
                   rdfs:isDefinedBy <http://w3id.org/coresense/cso> ;
                   rdfs:label "has role constraint"@en ;

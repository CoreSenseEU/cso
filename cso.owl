        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">state of relation</rdfs:label>
        <skos:definition xml:lang="en">Relates a binary relation state to the binary relation whose state it is.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#statusOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#statusOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ActionOrderStatus"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#ActionOrder"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">status of</rdfs:label>
        <skos:definition xml:lang="en">Relates an action order status to the action order whose status it records.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#trajectoryOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#trajectoryOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>

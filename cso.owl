        <rdfs:label xml:lang="en">played by</rdfs:label>
        <skos:definition xml:lang="en">Relates a role to an entity that assumes it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#producesData -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#producesData">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Sense"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Data"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">produces data</rdfs:label>
        <skos:definition xml:lang="en">Relates a sense action to the raw data it yields.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#pursuesGoal -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#pursuesGoal">

        <rdfs:label xml:lang="en">pursues goal</rdfs:label>
        <skos:definition xml:lang="en">Relates a term to a goal it is intended to contribute to.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#realizedBy -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#realizedBy">

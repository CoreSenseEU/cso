        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">state of</rdfs:label>
        <skos:definition xml:lang="en">Relates an entity state to the entity whose state it is.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#stateOfRelation -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#stateOfRelation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>

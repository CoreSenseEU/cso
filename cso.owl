        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">realized by</rdfs:label>
        <skos:definition xml:lang="en">Relates an estimation to the modelet-engine pair that realizes it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#realizes -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#realizes">

        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#System"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">trajectory of</rdfs:label>
        <skos:definition xml:lang="en">Relates a system trajectory to the system whose evolution it describes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#usedBy -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#usedBy">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Model"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">used by</rdfs:label>
        <skos:definition xml:lang="en">Relates a model to the entity that uses it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#usesEngine -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#usesEngine">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Exertion"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Engine"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">uses engine</rdfs:label>
        <skos:definition xml:lang="en">Relates an exertion to the engine that performs it.</skos:definition>
    </owl:ObjectProperty>
    



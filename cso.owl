     -->


    


    <!-- http://w3id.org/coresense/cso#abstractionLevel -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#abstractionLevel">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ModelMetadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">abstraction level</rdfs:label>
        <skos:definition xml:lang="en">The scope and detail level of a model, including the phenomena it includes and excludes.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#actualResponseTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#actualResponseTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#PerformanceConstraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">actual response time</rdfs:label>
        <skos:definition xml:lang="en">The response time actually attained when a model is used, in seconds.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#aspectDescription -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#aspectDescription">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">aspect description</rdfs:label>
        <skos:definition xml:lang="en">A textual account of the aspect of its referent that a modelet represents.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#assumption -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#assumption">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ModelMetadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">assumption</rdfs:label>
        <skos:definition xml:lang="en">A declared assumption, constraint or simplification made by a model.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#benefit -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#benefit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#StakeholderValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">benefit</rdfs:label>
        <skos:definition xml:lang="en">The amount of benefit provided to a stakeholder in a context.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#cost -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#cost">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#StakeholderValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">cost</rdfs:label>
        <skos:definition xml:lang="en">The cost at which benefit is provided to a stakeholder in a context.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#desiredEffect -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#desiredEffect">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Mission"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">desired effect</rdfs:label>
        <skos:definition xml:lang="en">An effect or target condition a mission aims to bring about.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#finalTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#finalTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#TimeInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">final time</rdfs:label>
        <skos:definition xml:lang="en">The time instant at which a time interval ends.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#hasAcceptanceCriterion -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#hasAcceptanceCriterion">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Capability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has acceptance criterion</rdfs:label>
        <skos:definition xml:lang="en">A criterion under which a capability counts as successfully performed.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#hasCondition -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#hasCondition">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has condition</rdfs:label>
        <skos:definition xml:lang="en">A condition deemed relevant in a context, or required for a capability to hold.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#hasDescription -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#hasDescription">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has description</rdfs:label>
        <skos:definition xml:lang="en">A textual account of a term instance.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#hasKnowledgeItem -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#hasKnowledgeItem">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Context"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has knowledge item</rdfs:label>
        <skos:definition xml:lang="en">A piece of content retained about an extended system in a context.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#hasResponsibility -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#hasResponsibility">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Role"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has responsibility</rdfs:label>
        <skos:definition xml:lang="en">A responsibility carried by an entity that assumes a role.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#hasRoleConstraint -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#hasRoleConstraint">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Role"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has role constraint</rdfs:label>
        <skos:definition xml:lang="en">A constraint imposed on an entity that assumes a role.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#identifier -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#identifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ModelMetadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
        <skos:definition xml:lang="en">A unique identifier for a model instance.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#information -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#information">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Feature"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">information</rdfs:label>
        <skos:definition xml:lang="en">The information content encoded by a feature.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#initialTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#initialTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#TimeInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">initial time</rdfs:label>
        <skos:definition xml:lang="en">The time instant at which a time interval starts.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#intendedUse -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#intendedUse">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ModelMetadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">intended use</rdfs:label>
        <skos:definition xml:lang="en">The purpose a model is intended for, such as simulation or prediction.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#isActionable -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#isActionable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">is actionable</rdfs:label>
        <skos:definition xml:lang="en">Whether a model can be used to produce action.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#isAdaptable -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#isAdaptable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#System"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">is adaptable</rdfs:label>
        <skos:definition xml:lang="en">Whether a system is able to change its own structure or behavior.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#isComposable -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#isComposable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">is composable</rdfs:label>
        <skos:definition xml:lang="en">Whether a model or modelet can be composed with others.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#isExertableOnItsOwn -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#isExertableOnItsOwn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">is exertable on its own</rdfs:label>
        <skos:definition xml:lang="en">Whether a model or modelet can be exerted without being composed with others.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#likelihood -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#likelihood">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Risk"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">likelihood</rdfs:label>
        <skos:definition xml:lang="en">The probability, between 0 and 1, that the adverse event of a risk occurs.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#maxResponseTime -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#maxResponseTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#PerformanceConstraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">maximum response time</rdfs:label>
        <skos:definition xml:lang="en">The largest response time admissible when a model is used, in seconds.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#maxUsers -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#maxUsers">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ScalabilityConstraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">maximum number of users</rdfs:label>
        <skos:definition xml:lang="en">The largest number of concurrent users admissible when a model is used.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#measureValue -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#measureValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#PerformanceMeasure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">measure value</rdfs:label>
        <skos:definition xml:lang="en">The value attained by a performance measure.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#modelClass -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#modelClass">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ModelMetadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">model class</rdfs:label>
        <skos:definition xml:lang="en">The abstract structure or mathematical category of a model.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#modelFormalism -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#modelFormalism">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ModelMetadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">model formalism</rdfs:label>
        <skos:definition xml:lang="en">The notation or formal representation used to express a model.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#modelledPhenomenon -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#modelledPhenomenon">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ModelMetadata"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">modelled phenomenon</rdfs:label>
        <skos:definition xml:lang="en">The real-world or conceptual system or process that a model represents.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#name -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#name">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">name</rdfs:label>
        <skos:definition xml:lang="en">The name by which a term instance is known.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#numberOfUsers -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#numberOfUsers">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ScalabilityConstraint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">number of users</rdfs:label>
        <skos:definition xml:lang="en">The number of concurrent users actually served when a model is used.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#rawValue -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#rawValue">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Data"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">raw value</rdfs:label>
        <skos:definition xml:lang="en">An encoded value carried by a datum.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#satisfactionCondition -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#satisfactionCondition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#MissionSuccessCriterion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">satisfaction condition</rdfs:label>
        <skos:definition xml:lang="en">The condition under which a mission success criterion counts as met.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#severity -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#severity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">severity</rdfs:label>
        <skos:definition xml:lang="en">The magnitude of the negative effect should the adverse event of a risk occur.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/coresense/cso#timeInstant -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/coresense/cso#timeInstant">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">time instant</rdfs:label>
        <skos:definition xml:lang="en">The time instant at which a state holds.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/coresense/cso#Action -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Action">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Editorial definition; the SysML v2 model reuses the standard library element Actions::Action.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action</rdfs:label>
        <skos:definition xml:lang="en">An action is a performance that an agent executes or commands in order to bring about a change in an extended system.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ActionOrder -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ActionOrder">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasAssignee"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasSpecification"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ActionSpecification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action order</rdfs:label>
        <skos:definition xml:lang="en">An action order is an executable directive, issued within a given context of an extended system, that activates the execution of the actions in a given action specification by the designated agents.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ActionOrderStatus -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ActionOrderStatus">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasStatus"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ActionStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#statusOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ActionOrder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Editorial definition; the SysML v2 model declares this element without prose.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action order status</rdfs:label>
        <skos:definition xml:lang="en">An action order status records the execution status reached by a given action order.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ActionSpecification -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ActionSpecification">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action specification</rdfs:label>
        <skos:definition xml:lang="en">An action specification is a concrete description, produced in response to an action trigger within a given context according to a chosen policy, that: (i) selects one or more actions from the candidate set determined by that policy, and (ii) assigns one or more responsible agents to each selected action.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ActionStatus -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ActionStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#aborted"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#failed"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#notTriggered"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#succeeded"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#timedOut"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">action status</rdfs:label>
        <skos:definition xml:lang="en">The execution status reached by an action order.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Actuator -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Actuator">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#commandedBy"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#executes"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">actuator</rdfs:label>
        <skos:definition xml:lang="en">An actuator is a physical entity that, when provided with an input, produces a physical effect on the environment or the system (e.g., motion, force, or flow), thereby executing actions commanded by an agent.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#AdverseOccurrence -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#AdverseOccurrence">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Editorial definition; the SysML v2 model declares this element without prose.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">adverse occurrence</rdfs:label>
        <skos:altLabel xml:lang="en">adverse event</skos:altLabel>
        <skos:definition xml:lang="en">An adverse occurrence is an occurrence whose happening would negatively affect an entity, system, or extended system.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Agent -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Agent">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#commands"/>
                        <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Action"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#executes"/>
                        <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Action"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">agent</rdfs:label>
        <skos:definition xml:lang="en">An agent is an entity capable of executing or commanding actions.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#BinaryRelation -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#BinaryRelation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">binary relation</rdfs:label>
        <skos:definition xml:lang="en">A binary relation is a relation between two entities, holding from a source entity to a target entity.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#BinaryRelationState -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#BinaryRelationState">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#stateOfRelation"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#BinaryRelation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">binary relation state</rdfs:label>
        <skos:definition xml:lang="en">The state of a binary relation at a given time instant is the tuple of the values of its attributes.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Capability -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Capability">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#capabilityOf"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#realizes"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Function"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">capability</rdfs:label>
        <skos:definition xml:lang="en">A capability is the ability of a system to perform a specific function successfully under stated conditions and acceptance criteria.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#CognitiveCapability -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#CognitiveCapability">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Capability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#realizes"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#CognitiveFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">cognitive capability</rdfs:label>
        <skos:definition xml:lang="en">A cognitive capability is a capability of a system that is realized by a cognitive function and enables the system to use knowledge to produce intentional action.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#CognitiveFunction -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#CognitiveFunction">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Function"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasModelet"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">cognitive function</rdfs:label>
        <skos:definition xml:lang="en">A cognitive function is a function that processes information by executing one or more modelets.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Concern -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Concern">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasStakeholder"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Stakeholder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">concern</rdfs:label>
        <skos:definition xml:lang="en">A concern is a matter of interest to a stakeholder that, in a given context, can be derived from a need and may give rise to requirements.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Context -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Context">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#concernsExtendedSystem"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">context</rdfs:label>
        <skos:definition xml:lang="en">Given an extended system, the context is the set of the content retained about that extended system, together with the assumptions and conditions, deemed relevant to interpret, evaluate and act within that extended system.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Data -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Data">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#concernsExtendedSystem"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">data</rdfs:label>
        <skos:definition xml:lang="en">Data are encoded representations of aspects of an entity or system (e.g., phenomena, properties, states, or attributes) in a form suitable for communication, storage, or processing.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Engine -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Engine">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#exerts"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">engine</rdfs:label>
        <skos:definition xml:lang="en">An engine is a component that exerts a modelet to derive a result.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Entity -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Entity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">entity</rdfs:label>
        <skos:definition xml:lang="en">An entity is any thing in the universe of discourse that can be distinguished from all other things in that universe.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#EntityState -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#EntityState">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#stateOf"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">entity state</rdfs:label>
        <skos:definition xml:lang="en">The state of an entity at a given time instant is the tuple of the values of its attributes.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Environment -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Environment">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#environmentOf"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">environment</rdfs:label>
        <skos:definition xml:lang="en">The environment of a system is the collection of entities that are not part of the system but are capable of influencing or being influenced by it.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#EpistemicState -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#EpistemicState">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Evidenced"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Limited"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Uncertain"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Validated"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">epistemic state</rdfs:label>
        <skos:definition xml:lang="en">The epistemic standing of a model: validated, evidenced, uncertain or limited.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Estimation -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Estimation">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#CognitiveFunction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#realizedBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#ModeletEnginePair"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">estimation</rdfs:label>
        <skos:definition xml:lang="en">Estimation is a cognitive function realized by a modelet-engine pair whose purpose is to infer unknown or uncertain quantities of a referent from available data and prior knowledge.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Evaluation -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Evaluation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#assessesProjection"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Projection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">evaluation</rdfs:label>
        <skos:definition xml:lang="en">Evaluation is an assessment of a projection with respect to a specific set of goals.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Exertion -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Exertion">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Action"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#exertsModelet"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#usesEngine"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Engine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">exertion</rdfs:label>
        <skos:altLabel xml:lang="en">exert</skos:altLabel>
        <skos:definition xml:lang="en">Exertion is the process of executing one or more modelets to given inputs in order to derive results about their referent.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ExhibitedBehavior -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ExhibitedBehavior">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasTrajectory"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#SystemTrajectory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">exhibited behavior</rdfs:label>
        <skos:definition xml:lang="en">The exhibited behavior of a system over an observational interval is the trajectory followed by the system during that interval.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ExtendedSystem -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ExtendedSystem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#System"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasEnvironment"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Environment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasTargetSystem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">extended system</rdfs:label>
        <skos:definition xml:lang="en">An extended system is composed of a target system together with its selected environment and the relations between both of them.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Feature -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Feature">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#concernsExtendedSystem"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">feature</rdfs:label>
        <skos:definition xml:lang="en">A feature is a derived piece of information that encodes some characteristic of an entity, system, phenomenon, or context, obtained from observations or sensor data and used as input to functions or modelets.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Function -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Function">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">function</rdfs:label>
        <skos:definition xml:lang="en">A function is a transformation that maps specific inputs to outputs.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Functionality -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Functionality">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasExpectedPerformance"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#PerformanceMeasure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasSubject"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#instantiatesCapability"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Capability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#pursuesGoal"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">functionality</rdfs:label>
        <skos:definition xml:lang="en">A functionality is an instantiation of a capability with some expected performance that is intended to satisfy one or more goals within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Goal -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Goal">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#concernsExtendedSystem"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasDesiredState"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#SystemState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">goal</rdfs:label>
        <skos:definition xml:lang="en">A goal is a subset of the possible states of an extended system representing the conditions that an agent intends to achieve or maintain.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#MOFLevel -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#MOFLevel">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#M0"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#M1"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#M2"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#M3"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">MOF level</rdfs:label>
        <skos:altLabel xml:lang="en">OMG MOF</skos:altLabel>
        <skos:definition xml:lang="en">The OMG Meta Object Facility metamodeling layer, M0 to M3, at which a model sits.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Meaning -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Meaning">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasInputFeature"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasModelet"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">meaning</rdfs:label>
        <skos:definition xml:lang="en">Meaning is the informational content produced by exerting one or more modelets on input features, representing an interpretation of a phenomenon of the associated extended system within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Metric -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Metric">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasMeasureType"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#PerformanceMeasureType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">metric</rdfs:label>
        <skos:definition xml:lang="en">A metric is a measure used to assess mission success.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Mission -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Mission">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">mission</rdfs:label>
        <skos:definition xml:lang="en">A mission is a high-level goal expressed as desired effects or target conditions for an extended system within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#MissionPlan -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#MissionPlan">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Action"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#addressesMission"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Mission"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasTask"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">mission plan</rdfs:label>
        <skos:definition xml:lang="en">A mission plan is a collection of tasks, together with any required precedence relations among them, to be carried out in order to satisfy the mission within the given extended system and context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#MissionSpecification -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#MissionSpecification">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#addressesMission"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Mission"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasSuccessCriterion"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#MissionSuccessCriterion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#pursuesGoal"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Goal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">mission specification</rdfs:label>
        <skos:definition xml:lang="en">A mission specification is the set of specific goals refining a given mission, together with the mission success criteria (expressed as metrics and their satisfaction conditions) that enable assessment of mission success.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#MissionSuccessCriterion -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#MissionSuccessCriterion">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasMetric"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Metric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">mission success criterion</rdfs:label>
        <skos:definition xml:lang="en">A mission success criterion pairs a metric with a satisfaction condition in a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Model -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Model">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasModelType"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ModelType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasModelet"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasReferent"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#usedBy"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">model</rdfs:label>
        <skos:definition xml:lang="en">A model is an entity that represents another entity (its referent).</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ModelMetadata -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ModelMetadata">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Editorial definition; the SysML v2 model declares this as a metadata definition nested in Model.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">model metadata</rdfs:label>
        <skos:definition xml:lang="en">Model metadata is the descriptive record of a model, covering its identity, modelled phenomenon, intended use, formalism, abstraction and metamodeling level, epistemic state, provenance and declared assumptions.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ModelType -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ModelType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#analyticalModel"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#descriptiveModel"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#hybridModel"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#metaModel"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#physicalModel"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">model type</rdfs:label>
        <skos:definition xml:lang="en">The kind of model, by the nature of its representation.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Modelet -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Modelet">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasAspect"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ModeletAspect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasReferent"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">modelet</rdfs:label>
        <skos:definition xml:lang="en">A modelet is a model fragment that represents a specific aspect of a referent system or entity.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ModeletAspect -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ModeletAspect">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#behaviorAspect"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#capabilityAspect"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#parameterAspect"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#performanceAspect"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#propertyAspect"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#statesAspect"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#structureAspect"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">modelet aspect</rdfs:label>
        <skos:definition xml:lang="en">The aspect of its referent that a modelet represents.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ModeletEnginePair -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ModeletEnginePair">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#pairsEngine"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Engine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#pairsModelet"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">modelet-engine pair</rdfs:label>
        <skos:definition xml:lang="en">A modelet-engine pair is the pairing of a modelet with an engine that can exert it.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#PerformanceConstraint -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#PerformanceConstraint">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Editorial definition; the SysML v2 model states this as a constraint definition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">performance constraint</rdfs:label>
        <skos:definition xml:lang="en">A performance constraint bounds the response time admissible when a model is used, for instance at run time.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#PerformanceMeasure -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#PerformanceMeasure">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasMeasureType"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#PerformanceMeasureType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasSubject"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#measuresBehavior"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ExhibitedBehavior"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">performance measure</rdfs:label>
        <skos:altLabel xml:lang="en">performance</skos:altLabel>
        <skos:definition xml:lang="en">Performance is a measure of how effectively the exhibited behavior of a system (or one of its components) contributes to fulfilling its goals when executing tasks within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#PerformanceMeasureType -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#PerformanceMeasureType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#MOE"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#MOP"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#TPM"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">performance measure type</rdfs:label>
        <skos:definition xml:lang="en">The kind of performance measure used to assess a system: measure of effectiveness, measure of performance, or technical performance measure.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Phenomenon -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Phenomenon">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#concernsExtendedSystem"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#exhibitedBy"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">phenomenon</rdfs:label>
        <skos:definition xml:lang="en">A phenomenon is any distinguishable aspect or behavior of an extended system, or of one of its parts, within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Policy -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Policy">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">policy</rdfs:label>
        <skos:definition xml:lang="en">A policy is a rule or strategy that, for a given action trigger and a given context of an extended system, determines a set of candidate actions that are admissible responses to that trigger in that context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#PotentialBehavior -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#PotentialBehavior">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#behaviorOf"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasTimeInterval"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#TimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">potential behavior</rdfs:label>
        <skos:definition xml:lang="en">The potential behavior of a system over a time interval is the set of all trajectories the system may follow over that interval.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Projection -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Projection">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasPotentialBehavior"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://w3id.org/coresense/cso#PotentialBehavior"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">projection</rdfs:label>
        <skos:definition xml:lang="en">Projection is a representation that maps a given situation of an extended system in a given context, into a representation in a chosen space, over a specified projection domain.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Provenance -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Provenance">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Derived"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Historical"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Original"/>
                    <rdf:Description rdf:about="http://w3id.org/coresense/cso#Versioned"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">provenance</rdfs:label>
        <skos:definition xml:lang="en">The origin and lifecycle standing of a model: original, derived, historical or versioned.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Risk -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Risk">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasAdverseEvent"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#AdverseOccurrence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">risk</rdfs:label>
        <skos:definition xml:lang="en">A risk is a measure of the potential for an adverse event to negatively affect an entity, system, or extended system within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Role -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Role">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#playedBy"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:definition xml:lang="en">A role is a context- and time-dependent designation, with associated responsibilities and constraints, that an entity may assume in order to contribute to the achievement or maintenance of a goal.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#ScalabilityConstraint -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#ScalabilityConstraint">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Editorial definition; the SysML v2 model states this as a constraint definition.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">scalability constraint</rdfs:label>
        <skos:definition xml:lang="en">A scalability constraint bounds the load, such as the number of concurrent users, admissible when a model is used.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SelfModel -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SelfModel">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Model"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasReferent"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#usedBy"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">self model</rdfs:label>
        <skos:definition xml:lang="en">A self model is a model whose referent is the owning system itself, so that referent and user coincide.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Sense -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Sense">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Action"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#producesData"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Data"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#sensesEntity"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">sense</rdfs:label>
        <skos:definition xml:lang="en">Sense is the action of acquiring raw sensor data about the phenomenon being observed in the extended system.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Sensor -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Sensor">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">sensor</rdfs:label>
        <skos:definition xml:lang="en">A sensor is an entity that acquires raw sensor data about phenomena, properties, states, or attributes of an entity being observed in the extended system.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Stakeholder -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Stakeholder">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">stakeholder</rdfs:label>
        <skos:definition xml:lang="en">A stakeholder is an entity for whom a system S is relevant because the behavior or outcomes of S can affect the achievement of its own goals.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#StakeholderValue -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#StakeholderValue">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasStakeholder"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Stakeholder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">stakeholder value</rdfs:label>
        <skos:definition xml:lang="en">Stakeholder value is the amount of benefit at a cost provided to stakeholders within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SuperSystem -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SuperSystem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#System"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasComponent"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">super system</rdfs:label>
        <skos:definition xml:lang="en">A super system is a system whose components are, themselves, systems.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#System -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#System">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">system</rdfs:label>
        <skos:definition xml:lang="en">A system is an entity represented by a tuple (C, R), where C is a set of components and R is the set of binary relations between them.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SystemOfInterest -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SystemOfInterest">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#concernsExtendedSystem"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasStakeholder"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Stakeholder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">system of interest</rdfs:label>
        <skos:definition xml:lang="en">For a given stakeholder, the system of interest is the part of an extended system that constitutes the focus of engineering activities.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SystemState -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SystemState">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#EntityState"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#stateOf"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">system state</rdfs:label>
        <skos:definition xml:lang="en">The state of a system at a time instant is the complete set of attribute values describing the current condition of its components and their relations.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#SystemTrajectory -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#SystemTrajectory">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasState"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#SystemState"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasTimeInterval"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#TimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#trajectoryOf"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#System"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">system trajectory</rdfs:label>
        <skos:altLabel xml:lang="en">trajectory</skos:altLabel>
        <skos:definition xml:lang="en">A trajectory is a time-ordered sequence of states representing one possible evolution of the system over a time interval.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Task -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Task">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Action"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasPlannedAction"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">task</rdfs:label>
        <skos:definition xml:lang="en">A task is a set of planned actions, executed by one or more agents, that is intended to contribute to the achievement of one or more goals within a given context.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#TimeInterval -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#TimeInterval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Editorial definition; the SysML v2 model states this structurally rather than in prose.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">time interval</rdfs:label>
        <skos:definition xml:lang="en">A time interval is the stretch of time delimited by an initial time instant and a later final time instant, both on the same time scale.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#Trigger -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#Trigger">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasTriggerCondition"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#TriggerCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">trigger</rdfs:label>
        <skos:altLabel xml:lang="en">action trigger</skos:altLabel>
        <skos:definition xml:lang="en">An action trigger is a condition on the state and/or exhibited behavior of an extended system, identified within a given context, whose satisfaction indicates the need to initiate the execution of one or more actions to contribute to the achievement or maintenance of one or more goals.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#TriggerCondition -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#TriggerCondition">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasContext"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/coresense/cso#Context"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Editorial definition; the SysML v2 model declares this as an abstract constraint definition to be redefined in usages.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">trigger condition</rdfs:label>
        <skos:definition xml:lang="en">A trigger condition is the condition, evaluated in a given context of an extended system, whose satisfaction fires an action trigger.</skos:definition>
    </owl:Class>
    


    <!-- http://w3id.org/coresense/cso#WorldModel -->


    <owl:Class rdf:about="http://w3id.org/coresense/cso#WorldModel">
        <rdfs:subClassOf rdf:resource="http://w3id.org/coresense/cso#Model"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/coresense/cso#hasReferent"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">world model</rdfs:label>
        <skos:definition xml:lang="en">A world model is a model whose referent is the extended system being operated in.</skos:definition>
    </owl:Class>
    



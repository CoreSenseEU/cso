        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Function"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">realizes</rdfs:label>
        <skos:definition xml:lang="en">Relates a capability to the function it makes available.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#requiresCapability -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#requiresCapability">

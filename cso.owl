<?xml version="1.0"?>
<rdf:RDF xmlns="http://w3id.org/coresense/cso#"
     xml:base="http://w3id.org/coresense/cso"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://w3id.org/coresense/cso">
        <owl:versionIRI rdf:resource="http://w3id.org/coresense/cso/2026-07-28"/>
        <terms:description xml:lang="en">The machine-consumable OWL 2 form of the CoreSense Ontology. CSO is
        authored by hand to match the SysML v2 model in sysml/ and the prose definitions in
        CS-115, which remain the conceptual source of record.</terms:description>
        <terms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:publisher xml:lang="en">The CORESENSE Consortium</terms:publisher>
        <terms:source rdf:resource="http://www.coresense.eu/doc/CS-115.pdf"/>
        <terms:title xml:lang="en">CoreSense Ontology (CSO)</terms:title>
        <rdfs:seeAlso rdf:resource="http://www.coresense.eu"/>
        <owl:versionInfo>2026-07-28</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel">
        <rdfs:label xml:lang="en">alternative label</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition">
        <rdfs:label xml:lang="en">definition</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/coresense/cso#addressesMission -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#addressesMission">
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Mission"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">addresses mission</rdfs:label>
        <skos:definition xml:lang="en">Relates a mission plan or mission specification to the mission it serves.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#assessesProjection -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#assessesProjection">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Evaluation"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Projection"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">assesses projection</rdfs:label>
        <skos:definition xml:lang="en">Relates an evaluation to the projection it assesses.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#assignedToAgent -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#assignedToAgent">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Action"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Agent"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">assigned to agent</rdfs:label>
        <skos:definition xml:lang="en">Relates an action to the agent made responsible for it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#behaviorOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#behaviorOf">
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#System"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://w3id.org/coresense/cso#hasTrajectory"/>
            <rdf:Description rdf:about="http://w3id.org/coresense/cso#trajectoryOf"/>
        </owl:propertyChainAxiom>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">behavior of</rdfs:label>
        <skos:definition xml:lang="en">Relates a behavior to the system that exhibits or may exhibit it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#capabilityOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#capabilityOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Capability"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#System"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">capability of</rdfs:label>
        <skos:definition xml:lang="en">Relates a capability to the system that holds it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#commandedBy -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#commandedBy">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Actuator"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Agent"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">commanded by</rdfs:label>
        <skos:definition xml:lang="en">Relates an actuator to an agent that commands it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#commands -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#commands">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Agent"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Action"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">commands</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent to an action whose execution it orders.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#concernsExtendedSystem -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#concernsExtendedSystem">
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">concerns extended system</rdfs:label>
        <skos:definition xml:lang="en">Relates a term to the extended system it is stated about.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#contributesToBehavior -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#contributesToBehavior">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Role"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#PotentialBehavior"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">contributes to behavior</rdfs:label>
        <skos:definition xml:lang="en">Relates a role to a potential behavior it contributes to.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#contributesToFunction -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#contributesToFunction">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Role"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Function"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">contributes to function</rdfs:label>
        <skos:definition xml:lang="en">Relates a role to a function it contributes to.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#describesEntity -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#describesEntity">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Feature"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">describes entity</rdfs:label>
        <skos:definition xml:lang="en">Relates a feature to the entity it characterizes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#describesPhenomenon -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#describesPhenomenon">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Feature"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Phenomenon"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">describes phenomenon</rdfs:label>
        <skos:definition xml:lang="en">Relates a feature to the phenomenon it characterizes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#desires -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#desires">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Stakeholder"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Goal"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">desires</rdfs:label>
        <skos:altLabel xml:lang="en">desire</skos:altLabel>
        <skos:definition xml:lang="en">Relates a stakeholder to a goal it wishes to see achieved or maintained.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#environmentOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#environmentOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Environment"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#System"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">environment of</rdfs:label>
        <skos:definition xml:lang="en">Relates an environment to the system whose environment it is.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#executes -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#executes">
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Action"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">executes</rdfs:label>
        <skos:definition xml:lang="en">Relates an agent or actuator to an action it carries out.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#exerts -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#exerts">
        <rdfs:subPropertyOf rdf:resource="http://w3id.org/coresense/cso#hasModelet"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Engine"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">exerts</rdfs:label>
        <skos:definition xml:lang="en">Relates an engine to a modelet it is able to exert.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#exertsModelet -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#exertsModelet">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Exertion"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">exerts modelet</rdfs:label>
        <skos:definition xml:lang="en">Relates an exertion to a modelet executed in it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#exhibitedBy -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#exhibitedBy">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Phenomenon"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">exhibited by</rdfs:label>
        <skos:definition xml:lang="en">Relates a phenomenon to an entity that exhibits it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#focusesOnSystem -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#focusesOnSystem">
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#System"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://w3id.org/coresense/cso#concernsExtendedSystem"/>
            <rdf:Description rdf:about="http://w3id.org/coresense/cso#hasTargetSystem"/>
        </owl:propertyChainAxiom>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">focuses on system</rdfs:label>
        <skos:definition xml:lang="en">Relates a system of interest to the target system of the extended system it concerns.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#followsPolicy -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#followsPolicy">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ActionSpecification"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Policy"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">follows policy</rdfs:label>
        <skos:definition xml:lang="en">Relates an action specification to the policy that determined its candidate actions.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasAdverseEvent -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasAdverseEvent">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Risk"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#AdverseOccurrence"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has adverse event</rdfs:label>
        <skos:definition xml:lang="en">Relates a risk to the adverse occurrence whose potential it measures.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasAspect -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasAspect">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Modelet"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#ModeletAspect"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has aspect</rdfs:label>
        <skos:definition xml:lang="en">Relates a modelet to the aspect of its referent that it represents.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasAssignee -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasAssignee">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ActionOrder"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Agent"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has assignee</rdfs:label>
        <skos:definition xml:lang="en">Relates an action order to the agent designated to execute it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasCandidateAction -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasCandidateAction">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Policy"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Action"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has candidate action</rdfs:label>
        <skos:definition xml:lang="en">Relates a policy to an action it may select as an admissible response.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasComponent -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasComponent">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#System"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has component</rdfs:label>
        <skos:definition xml:lang="en">Relates a system to one of the entities that compose it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasComponentState -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasComponentState">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#SystemState"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#EntityState"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has component state</rdfs:label>
        <skos:definition xml:lang="en">Relates a system state to the state of one of the components of that system.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasContext -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasContext">
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Context"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has context</rdfs:label>
        <skos:definition xml:lang="en">Relates a term to the context within which it is stated.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasDesiredState -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasDesiredState">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Goal"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#SystemState"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has desired state</rdfs:label>
        <skos:definition xml:lang="en">Relates a goal to a system state it aims to achieve or maintain.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasEnvironment -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasEnvironment">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ExtendedSystem"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Environment"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has environment</rdfs:label>
        <skos:definition xml:lang="en">Relates an extended system to the environment of its target system.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasEnvironmentEntity -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasEnvironmentEntity">
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has environment entity</rdfs:label>
        <skos:definition xml:lang="en">Relates an environment, or an extended system, to an entity that belongs to that environment.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasEpistemicState -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasEpistemicState">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ModelMetadata"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#EpistemicState"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has epistemic state</rdfs:label>
        <skos:definition xml:lang="en">Relates model metadata to the epistemic standing of the model.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasExpectedPerformance -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasExpectedPerformance">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Functionality"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#PerformanceMeasure"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has expected performance</rdfs:label>
        <skos:definition xml:lang="en">Relates a functionality to a performance measure it is expected to attain.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasInputFeature -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#hasInputFeature">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Meaning"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Feature"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">has input feature</rdfs:label>
        <skos:definition xml:lang="en">Relates a meaning to a feature it was derived from.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#hasInterestIn -->



        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Capability"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">requires capability</rdfs:label>
        <skos:definition xml:lang="en">Relates a task to a capability of the target system that the task requires.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#respondsToTrigger -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#respondsToTrigger">
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Trigger"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">responds to trigger</rdfs:label>
        <skos:definition xml:lang="en">Relates a policy or action specification to the action trigger it answers.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#selectsAction -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#selectsAction">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#ActionSpecification"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Action"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">selects action</rdfs:label>
        <skos:definition xml:lang="en">Relates an action specification to an action it selects for execution.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#senses -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#senses">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Sensor"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Sense"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">senses</rdfs:label>
        <skos:definition xml:lang="en">Relates a sensor to a sense action it performs.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#sensesEntity -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#sensesEntity">
        <rdfs:domain rdf:resource="http://w3id.org/coresense/cso#Sense"/>
        <rdfs:range rdf:resource="http://w3id.org/coresense/cso#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://w3id.org/coresense/cso"/>
        <rdfs:label xml:lang="en">senses entity</rdfs:label>
        <skos:definition xml:lang="en">Relates a sense action to the entity it acquires data about.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/coresense/cso#stateOf -->


    <owl:ObjectProperty rdf:about="http://w3id.org/coresense/cso#stateOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
